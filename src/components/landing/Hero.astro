---
import { useTranslations } from "../../data/locales";
import { buildLocalizedPath, type Language } from "../../lib/i18n";
import Compass from "./Compass.astro";
import Arrow from "../ui/Arrow.astro";

interface Props {
  lang?: Language;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="frame hero__grid">
    <p class="hero__eyebrow label">
      <span class="signal" aria-hidden="true"></span>
      {t("hero.eyebrow")}
    </p>

    <div class="hero__instrument">
      <Compass />
    </div>

    <h1 id="hero-heading" class="hero__title">
      {t("hero.title1")} <br class="hero__break" /><span class="hero__accent">{t("hero.titleAccent")}</span>
      {t("hero.title2")}
    </h1>

    <div class="hero__lead">
      <p class="hero__body">{t("hero.body")}</p>
      <p class="hero__note">{t("hero.stackNote")}</p>
    </div>

    <div class="hero__actions" role="group" aria-label="Primary actions">
      <a href={buildLocalizedPath("/spec", lang)} class="btn btn-primary">
        {t("hero.ctaRead")}
        <Arrow class="btn-arrow" />
      </a>
      <a href={buildLocalizedPath("/compare", lang)} class="btn btn-secondary">
        {t("hero.ctaCompare")}
      </a>
      <span class="hero__links">
        <a href="https://github.com/berthelius/north" target="_blank" rel="noopener noreferrer" class="text-link">
          GitHub
          <Arrow dir="up-right" />
        </a>
        <a href="#template" class="text-link">{t("hero.ctaCopy")}</a>
      </span>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(1.5rem, 3.5vw, 3rem) clamp(4rem, 8vw, 6.5rem);
  }

  /* Mobile: the instrument is a small dial in the masthead, opposite the label. */
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "eyebrow instrument"
      "title title"
      "lead lead"
      "actions actions";
  }

  .hero__eyebrow {
    grid-area: eyebrow;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    align-self: stretch;
    margin: 0;
    padding-right: 1rem;
    color: var(--muted);
    border-bottom: 1px solid var(--fg);
  }

  .hero__instrument {
    grid-area: instrument;
    width: 4.75rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--fg);
  }

  .hero__title {
    grid-area: title;
    margin: clamp(1.75rem, 4vw, 2.75rem) 0 0;
    font-size: clamp(2.85rem, 13.4vw, 7.25rem);
    letter-spacing: 0;
    color: var(--fg);
  }

  .hero__break {
    display: none;
  }

  .hero__accent {
    color: var(--accent);
  }

  .hero__lead {
    grid-area: lead;
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
    max-width: 36rem;
  }

  .hero__body {
    margin: 0;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.55;
    color: var(--fg);
  }

  .hero__note {
    margin: 1.1rem 0 0;
    padding-left: 1rem;
    border-left: 1px solid var(--accent);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .hero__actions {
    grid-area: actions;
    display: grid;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
    margin-top: 0.25rem;
  }

  @media (min-width: 640px) {
    .hero__break {
      display: inline;
    }

    .hero__actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
    }

    .hero__links {
      margin: 0 0 0 0.75rem;
    }
  }

  /* Desktop: headline and lead on the left, the instrument holds the right. */
  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      grid-template-areas:
        "eyebrow eyebrow"
        "title instrument"
        "lead instrument"
        "actions instrument";
      grid-template-rows: auto auto auto 1fr;
      column-gap: clamp(2rem, 5vw, 5rem);
    }

    .hero__eyebrow {
      padding-block: 0 0.9rem;
    }

    .hero__instrument {
      align-self: center;
      justify-self: end;
      width: min(100%, 28rem);
      margin-top: clamp(1.75rem, 4vw, 2.75rem);
      padding: 0;
      border: 0;
    }

    .hero__title {
      font-size: clamp(3.5rem, 6.4vw, 6.5rem);
    }
  }
</style>
