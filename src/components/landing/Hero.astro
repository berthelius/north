---
import { useTranslations } from "../../data/locales";
import { buildLocalizedPath, type Language } from "../../lib/i18n";

interface Props {
  lang?: Language;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
---

<section
  class="hero-section mx-auto max-w-[var(--max-prose,72ch)] px-[var(--spacing-gutter)] pt-[clamp(5rem,10vw,9rem)] pb-[var(--spacing-section)]"
  aria-labelledby="hero-heading"
>
  <div class="flex items-center gap-2 hero-eyebrow">
    <span class="inline-block w-2 h-2 rounded-full bg-[var(--accent)] animate-pulse" aria-hidden="true"></span>
    <p
      class="font-mono text-[0.7rem] uppercase tracking-[0.22em] text-[var(--muted)] select-none"
    >
      {t("hero.eyebrow")}
    </p>
  </div>

  <h1
    id="hero-heading"
    class="hero-headline mt-5 font-display text-[clamp(2.75rem,7vw,6.25rem)] leading-[0.95] tracking-[0.02em] text-[var(--fg)] uppercase"
  >
    {t("hero.title1")} <br class="hidden sm:block" /><span
      class="text-[var(--accent)]"
      >{t("hero.titleAccent")}</span
    > {t("hero.title2")}
  </h1>

  <p
    class="hero-body mt-8 max-w-[58ch] text-[clamp(1.05rem,2vw,1.25rem)] text-[var(--muted)] leading-[1.6]"
  >
    {t("hero.body")}
  </p>

  <p
    class="hero-layers mt-5 max-w-[58ch] text-[var(--muted)] text-base leading-[1.6]"
  >
    {t("hero.stackNote")}
  </p>

  <div
    class="hero-cta mt-10 flex flex-wrap items-center gap-3"
    role="group"
    aria-label="Primary actions"
  >
    <a
      href={buildLocalizedPath("/spec", lang)}
      class="inline-flex items-center gap-2 rounded-full bg-[var(--fg)] px-5 py-2.5 text-sm font-medium text-[var(--bg)] transition-opacity duration-150 hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
    >
      {t("hero.ctaRead")}
      <span aria-hidden="true">&rarr;</span>
    </a>
    <a
      href={buildLocalizedPath("/compare", lang)}
      class="inline-flex items-center gap-2 rounded-full border border-[var(--rule)] px-5 py-2.5 text-sm font-medium text-[var(--fg)] transition-colors duration-150 hover:bg-[var(--rule)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
    >
      {t("hero.ctaCompare")}
    </a>
    <a
      href="https://github.com/berthelius/north"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-full border border-[var(--rule)] px-5 py-2.5 text-sm font-medium text-[var(--fg)] transition-colors duration-150 hover:bg-[var(--rule)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
    >
      GitHub
      <svg
        aria-hidden="true"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="shrink-0"
      >
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
        ></path>
        <polyline points="15 3 21 3 21 9"></polyline>
        <line x1="10" y1="14" x2="21" y2="3"></line>
      </svg>
    </a>
    <a
      href="#template"
      class="text-sm text-[var(--muted)] decoration-dotted underline underline-offset-4 hover:text-[var(--fg)] transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)] rounded-sm"
    >
      {t("hero.ctaCopy")}
    </a>
  </div>
</section>

<style>
  /* Enter animation: lift only. No opacity fade, so text is painted (and counted as LCP) from the first frame. */
  @keyframes fade-up {
    from {
      transform: translateY(18px);
    }
    to {
      transform: translateY(0);
    }
  }

  .hero-eyebrow {
    animation: fade-up 0.5s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1))
      both;
    animation-delay: 0ms;
  }
  .hero-headline {
    animation: fade-up 0.6s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1))
      both;
    animation-delay: 60ms;
  }
  .hero-body {
    animation: fade-up 0.6s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1))
      both;
    animation-delay: 120ms;
  }
  .hero-layers {
    animation: fade-up 0.6s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1))
      both;
    animation-delay: 160ms;
  }
  .hero-cta {
    animation: fade-up 0.6s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1))
      both;
    animation-delay: 220ms;
  }

  /* Reduced motion: global.css zeros durations, so no JS needed */
</style>
