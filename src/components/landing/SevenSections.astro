---
import { useTranslations } from "../../data/locales";
import { buildLocalizedPath, type Language } from "../../lib/i18n";

interface Props {
  lang?: Language;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

// Anchor ids in src/pages/es/spec.astro differ from the EN slugs.
const ES_SLUGS: Record<string, string> = {
  "asymmetric-bets": "apuestas-asimetricas",
  "anti-goals": "anti-objetivos",
  "trade-off-defaults": "trade-offs",
  "ambition-triggers": "disparadores",
  reversibility: "reversibilidad",
};
const anchorFor = (slug: string) => (lang === "es" ? (ES_SLUGS[slug] ?? slug) : slug);

const sections = [
  {
    num: 1,
    name: t("sec.1.name"),
    slug: "north-star",
    desc: t("sec.1.desc"),
  },
  {
    num: 2,
    name: t("sec.2.name"),
    slug: "the-bar",
    desc: t("sec.2.desc"),
  },
  {
    num: 3,
    name: t("sec.3.name"),
    slug: "asymmetric-bets",
    desc: t("sec.3.desc"),
  },
  {
    num: 4,
    name: t("sec.4.name"),
    slug: "anti-goals",
    desc: t("sec.4.desc"),
  },
  {
    num: 5,
    name: t("sec.5.name"),
    slug: "trade-off-defaults",
    desc: t("sec.5.desc"),
  },
  {
    num: 6,
    name: t("sec.6.name"),
    slug: "ambition-triggers",
    desc: t("sec.6.desc"),
  },
  {
    num: 7,
    name: t("sec.7.name"),
    slug: "reversibility",
    desc: t("sec.7.desc"),
  },
];
---

<section
  class="sections-section mx-auto max-w-[var(--max-prose,72ch)] px-[var(--spacing-gutter)] py-[var(--spacing-section)] border-t border-[var(--rule)]"
  aria-labelledby="sections-heading"
>
  <h2
    id="sections-heading"
    class="font-display text-[clamp(1.75rem,4vw,2.75rem)] tracking-[0.02em] text-[var(--fg)] uppercase"
  >
    {t("sections.title")}
  </h2>
  <p class="mt-3 max-w-[52ch] text-[var(--muted)] leading-[1.65]">
    {t("sections.desc")}
  </p>

  <ol
    class="sections-grid mt-10 grid gap-px border border-[var(--rule)] rounded-lg overflow-hidden bg-[var(--rule)]"
    role="list"
    aria-label="The seven canonical NORTH.md sections"
  >
    {
      sections.map((s) => (
        <li class="bg-[var(--bg)]" role="listitem">
          <a
            href={buildLocalizedPath(`/spec#${anchorFor(s.slug)}`, lang)}
            class="section-item group flex items-start gap-4 px-6 py-5 transition-colors duration-150 hover:bg-[var(--color-stone-100,#f5f5f4)] dark:hover:bg-[var(--color-stone-900,#1c1917)] focus-visible:outline-2 focus-visible:outline-[var(--accent)] focus-visible:outline-offset-[-2px]"
          >
            <span
              class="shrink-0 mt-0.5 font-mono text-xs text-[var(--muted)] w-5 select-none"
              aria-hidden="true"
            >
              {String(s.num).padStart(2, "0")}
            </span>
            <span class="min-w-0">
              <span class="block font-medium text-[var(--fg)] group-hover:text-[var(--accent)] transition-colors duration-150">
                {s.name}
              </span>
              <span class="block mt-1 text-sm text-[var(--muted)] leading-[1.55]">
                {s.desc}
              </span>
            </span>
            <span
              class="shrink-0 ml-auto pl-4 mt-0.5 text-[var(--muted)] opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-opacity duration-150"
              aria-hidden="true"
            >
              →
            </span>
          </a>
        </li>
      ))
    }
  </ol>

  <p class="mt-6 text-sm text-[var(--muted)]">
    <a
      href={buildLocalizedPath("/spec", lang)}
      class="decoration-dotted underline underline-offset-4 hover:text-[var(--fg)] transition-colors duration-150"
      >{t("sections.readFull")}</a
    >
  </p>
</section>
