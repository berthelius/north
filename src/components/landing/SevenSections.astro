---
import { useTranslations } from "../../data/locales";
import { buildLocalizedPath, type Language } from "../../lib/i18n";
import Arrow from "../ui/Arrow.astro";

interface Props {
  lang?: Language;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const sections = [
  {
    num: 1,
    name: t("sec.1.name"),
    slug: "north-star",
    desc: t("sec.1.desc"),
  },
  {
    num: 2,
    name: t("sec.2.name"),
    slug: "the-bar",
    desc: t("sec.2.desc"),
  },
  {
    num: 3,
    name: t("sec.3.name"),
    slug: "asymmetric-bets",
    desc: t("sec.3.desc"),
  },
  {
    num: 4,
    name: t("sec.4.name"),
    slug: "anti-goals",
    desc: t("sec.4.desc"),
  },
  {
    num: 5,
    name: t("sec.5.name"),
    slug: "trade-off-defaults",
    desc: t("sec.5.desc"),
  },
  {
    num: 6,
    name: t("sec.6.name"),
    slug: "ambition-triggers",
    desc: t("sec.6.desc"),
  },
  {
    num: 7,
    name: t("sec.7.name"),
    slug: "reversibility",
    desc: t("sec.7.desc"),
  },
];
---

<section class="section sections" aria-labelledby="sections-heading">
  <div class="frame">
    <header class="section-head">
      <h2 id="sections-heading" class="section-title">{t("sections.title")}</h2>
      <p class="section-desc">{t("sections.desc")}</p>
    </header>

    <ol class="index" role="list" aria-label={t("sections.list")}>
      {sections.map((s) => (
        <li role="listitem">
          <a href={buildLocalizedPath(`/spec#${s.slug}`, lang)} class="index__row">
            <span class="index__num label" aria-hidden="true">{String(s.num).padStart(2, "0")}</span>
            <span class="index__name">{s.name}</span>
            <span class="index__desc">{s.desc}</span>
            <Arrow class="index__arrow" />
          </a>
        </li>
      ))}
    </ol>

    <p class="sections__foot">
      <a href={buildLocalizedPath("/spec", lang)} class="text-link">{t("sections.readFull")}</a>
    </p>
  </div>
</section>

<style>
  .index {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }

  .index__row {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    grid-template-areas:
      "num name arrow"
      "num desc desc";
    align-items: baseline;
    column-gap: 0.75rem;
    padding-block: 1.25rem 1.35rem;
    border-top: 1px solid var(--rule);
    color: var(--fg);
    text-decoration: none;
  }

  .index__num {
    grid-area: num;
    color: var(--muted);
    transition: color 160ms;
  }

  .index__name {
    grid-area: name;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 7.4vw, 2.75rem);
    line-height: 1;
    text-transform: uppercase;
    transition: color 160ms;
  }

  .index__desc {
    grid-area: desc;
    margin-top: 0.55rem;
    max-width: 32rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .index__row :global(.index__arrow) {
    grid-area: arrow;
    align-self: center;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--muted);
    transition:
      transform 260ms var(--ease-out-expo),
      color 160ms;
  }

  .index__row:hover .index__num,
  .index__row:hover :global(.index__arrow) {
    color: var(--fg);
  }

  .index__row:hover .index__name {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }

  .index__row:hover :global(.index__arrow) {
    transform: translateX(4px);
  }

  .index__row:focus-visible {
    outline-offset: -2px;
  }

  .sections__foot {
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    font-size: 0.9375rem;
  }

  @media (min-width: 960px) {
    .index__row {
      grid-template-columns: 4rem minmax(0, 6fr) minmax(0, 5fr) 3rem;
      grid-template-areas: "num name desc arrow";
      column-gap: 2rem;
      padding-block: 1.6rem;
    }

    .index__name {
      font-size: clamp(2.25rem, 3.6vw, 3.25rem);
    }

    .index__desc {
      margin: 0;
    }

    .index__row :global(.index__arrow) {
      justify-self: end;
    }
  }
</style>
