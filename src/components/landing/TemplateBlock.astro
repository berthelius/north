---
import CodeBlock from "../interactive/CodeBlock.astro";
import { useTranslations } from "../../data/locales";
import type { Language } from "../../lib/i18n";

interface Props {
  lang?: Language;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const template = `<!-- NORTH.md spec: v0.1 -->

# NORTH.md

## 1. North Star
[One sentence. The destination, not the roadmap.]

## 2. The Bar
[What quality threshold counts as "shipped".]

## 3. Asymmetric Bets
[Where we go 10x. Where we accept 1.1x.]

## 4. Anti-Goals
[What we refuse, even when easy or profitable.]

## 5. Trade-off Defaults
| Trade-off | Default | Flip when |
|---|---|---|
| Speed vs. safety | Safety on core logic; speed on internal tools | Never flip on fiscal/security code |
| Build vs. buy | Buy infrastructure; build core product | Vendor breaks unit economics |

## 6. Ambition Triggers
[Phrases that escalate scope when we are being too small.]

## 7. Reversibility
[One-way doors flagged. Two-way doors = move fast.]`;

const steps = [
  {
    n: "1",
    text: t("template.step1"),
    code: "NORTH.md",
  },
  {
    n: "2",
    text: t("template.step2"),
    code: "CLAUDE.md",
    suffix: t("template.step2Suffix"),
  },
  {
    n: "3",
    text: t("template.step3"),
    code: null,
  },
];
---

<section
  id="template"
  class="template-section mx-auto max-w-[var(--max-prose,72ch)] px-[var(--spacing-gutter)] py-[var(--spacing-section)] border-t border-[var(--rule)]"
  aria-labelledby="template-heading"
>
  <h2
    id="template-heading"
    class="font-display text-[clamp(1.75rem,4vw,2.75rem)] tracking-[0.02em] text-[var(--fg)] uppercase"
  >
    {t("template.title")}
  </h2>
  <p class="mt-3 max-w-[52ch] text-[var(--muted)] leading-[1.65]">
    {t("template.desc")}
  </p>

  <div class="mt-8">
    <CodeBlock code={template} lang="markdown" />
  </div>

  <ol
    class="mt-8 space-y-4"
    aria-label="Three steps to adopt NORTH.md"
  >
    {
      steps.map((step) => (
        <li class="flex items-baseline gap-4">
          <span
            class="shrink-0 font-mono text-xs text-[var(--muted)] w-4 select-none"
            aria-hidden="true"
          >
            {step.n}.
          </span>
          <span class="text-sm text-[var(--muted)] leading-[1.6]">
            {step.text}{" "}
            {step.code && (
              <code class="font-mono text-[0.9em] text-[var(--fg)]">
                {step.code}
              </code>
            )}
            {"suffix" in step ? step.suffix : ""}
          </span>
        </li>
      ))
    }
  </ol>
</section>
