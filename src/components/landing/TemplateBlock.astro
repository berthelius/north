---
import CodeBlock from "../interactive/CodeBlock.astro";
import template from "../../../skills/north-adoption/assets/NORTH.template.md?raw";
import { useTranslations } from "../../data/locales";
import type { Language } from "../../lib/i18n";

interface Props {
  lang?: Language;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const steps = [
  {
    n: "1",
    text: t("template.step1"),
    code: "NORTH.md",
  },
  {
    n: "2",
    text: t("template.step2"),
    code: "CLAUDE.md",
    suffix: t("template.step2Suffix"),
  },
  {
    n: "3",
    text: t("template.step3"),
    code: null,
  },
];
---

<section id="template" class="template" aria-labelledby="template-heading">
  <div class="frame template__grid">
    <div class="template__intro">
      <h2 id="template-heading" class="section-title">{t("template.title")}</h2>
      <p class="template__desc">{t("template.desc")}</p>

      <ol class="template__steps" aria-label={t("template.steps")}>
        {steps.map((step) => (
          <li>
            <span class="template__n label" aria-hidden="true">{step.n}.</span>
            <span>
              {step.text}{" "}
              {step.code && <code>{step.code}</code>}
              {"suffix" in step ? step.suffix : ""}
            </span>
          </li>
        ))}
      </ol>
    </div>

    <CodeBlock code={template.trimEnd()} lang="markdown" locale={lang} />
  </div>
</section>

<style>
  /* The one ink spread on the page: it stays dark in both schemes. */
  .template {
    --fg: var(--ink-fg);
    --muted: var(--ink-muted);
    --rule: var(--ink-rule);
    padding-block: var(--spacing-section);
    background: var(--ink-bg);
    color: var(--ink-fg);
    border-block: 1px solid var(--ink-rule);
  }

  .template__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .template__intro h2 {
    color: var(--ink-fg);
  }

  .template__desc {
    margin: 1.25rem 0 0;
    max-width: 30rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .template__steps {
    margin: 2.25rem 0 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--ink-rule);
  }

  .template__steps li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    align-items: baseline;
    padding-block: 0.9rem;
    border-top: 1px solid var(--ink-rule);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .template__n {
    color: var(--ink-fg);
    font-weight: 700;
  }

  .template__steps code {
    color: var(--ink-fg);
  }

  @media (min-width: 960px) {
    .template__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }

    .template__intro {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }
</style>
