---
import { useTranslations } from "../../data/locales";
import { buildLocalizedPath, type Language } from "../../lib/i18n";
import NorthMark from "../ui/NorthMark.astro";

interface Props {
  lang?: Language;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const newTab = t("a11y.newTab");
---

<footer class="site-footer" aria-label={t("footer.label")}>
  <div class="frame site-footer__grid">
    <nav class="site-footer__stack" aria-label={t("footer.stackNav")}>
      <p class="label site-footer__label">{t("footer.stack")}</p>
      <ul role="list">
        <li><span>CONSTITUTION.md</span></li>
        <li>
          <a href="https://agents.md" target="_blank" rel="noopener noreferrer" aria-label={`AGENTS.md — ${newTab}`}>AGENTS.md</a>
        </li>
        <li><span>DESIGN.md</span></li>
        <li>
          <a href="https://soul.md" target="_blank" rel="noopener noreferrer" aria-label={`SOUL.md — ${newTab}`}>SOUL.md</a>
        </li>
        <li><span class="site-footer__north" aria-current="page">NORTH.md</span></li>
      </ul>
    </nav>

    <ul class="site-footer__pages" role="list">
      <li><a href={buildLocalizedPath("/spec", lang)}>{t("nav.spec")}</a></li>
      <li><a href={buildLocalizedPath("/compare", lang)}>{t("nav.compare")}</a></li>
      <li><a href={buildLocalizedPath("/why", lang)}>{t("nav.why")}</a></li>
      <li><a href={buildLocalizedPath("/examples", lang)}>{t("nav.examples")}</a></li>
      <li><a href={buildLocalizedPath("/faq", lang)}>{t("nav.faq")}</a></li>
    </ul>

    <div class="site-footer__meta">
      <span class="site-footer__brand">
        <span class="site-footer__word">NORTH<span class="site-footer__ext">.md</span></span>
        <NorthMark class="site-footer__mark" />
      </span>
      <p>
        MIT ·
        <a href="https://www.brthls.com" target="_blank" rel="noopener noreferrer" aria-label={`Viktor Berthelius — ${newTab}`}>Viktor Berthelius</a> ·
        <a href="https://github.com/berthelius/north" target="_blank" rel="noopener noreferrer" aria-label={`${t("a11y.githubRepo")} — ${newTab}`}>GitHub</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--fg);
    font-size: 0.875rem;
  }

  .site-footer__grid {
    display: grid;
    gap: 2.5rem;
  }

  .site-footer ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__label {
    margin: 0 0 1rem;
    color: var(--muted);
  }

  .site-footer__stack ul {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .site-footer__stack li {
    display: flex;
    align-items: center;
    min-height: 2rem;
    border-top: 1px solid var(--rule);
  }

  .site-footer__stack li:last-child {
    border-bottom: 1px solid var(--rule);
  }

  /* Current layer: ink and bold against the muted list, not colour alone. */
  .site-footer__north {
    color: var(--fg);
    font-weight: 700;
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
    transition: color 160ms;
  }

  .site-footer a:hover {
    color: var(--fg);
    text-decoration: underline;
  }

  .site-footer__pages {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }

  .site-footer__pages a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--fg);
  }

  /* Lockup and credits share a line where they fit; in the narrow desktop
     column the credits drop below the lockup as one line, not mid-credit. */
  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.85rem;
    color: var(--muted);
  }

  .site-footer__meta p {
    margin: 0;
  }

  .site-footer__meta a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--fg);
  }

  /* The header lockup at footer size (needle and gap in em, as there). */
  .site-footer__brand {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.162em;
    font-size: 1.25rem;
    font-weight: 900;
    line-height: 1;
    color: var(--fg);
  }

  .site-footer__word {
    letter-spacing: -0.07em;
  }

  .site-footer__ext {
    letter-spacing: -0.04em;
  }

  .site-footer__brand :global(.site-footer__mark) {
    width: 0.1905em;
    margin-top: 0.019em;
  }

  @media (min-width: 960px) {
    .site-footer__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 3fr);
      column-gap: clamp(2rem, 5vw, 5rem);
      align-items: start;
    }

    .site-footer ul.site-footer__pages {
      flex-direction: column;
      padding-top: 2.1rem;
    }

    .site-footer__pages a {
      min-height: 2rem;
    }

    .site-footer__meta {
      justify-self: end;
      align-self: end;
    }
  }
</style>
