---
import { useTranslations } from "../../data/locales";
import { buildLocalizedPath, type Language } from "../../lib/i18n";
import Arrow from "../ui/Arrow.astro";

interface Props {
  lang?: Language;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

// The five strata, from the floor (limits) up to the direction (NORTH.md).
const layers = [
  {
    level: "L1",
    word: "Limits",
    tag: "Safety",
    file: "CONSTITUTION.md",
    desc: "Negative invariants, compliance red lines, and forbidden operations.",
    origin: { text: "Community · agentconstitution.dev" },
  },
  {
    level: "L2",
    word: "How",
    tag: "Execution",
    file: "AGENTS.md",
    desc: "Build commands, linter flags, workspace paths, and test runners.",
    origin: { text: "Linux Foundation", href: "https://agents.md", external: true },
  },
  {
    level: "L3",
    word: "Look",
    tag: "UI Contract",
    file: "DESIGN.md",
    desc: "UI tokens, responsive layout contracts, and design system primitives.",
    origin: { text: "Google Labs" },
  },
  {
    level: "L4",
    word: "Who",
    tag: "Voice",
    file: "SOUL.md",
    desc: "Agent persona: voice, values, tone.",
    origin: { text: "soul.md", href: "https://soul.md", external: true },
  },
  {
    level: "L5",
    word: "Why",
    tag: "Direction",
    file: "NORTH.md",
    desc: "Purpose, the quality bar, asymmetric bets, and precomputed trade-offs.",
    origin: { text: "BRTHLS · Spec v0.1", href: buildLocalizedPath("/spec", lang) },
    north: true,
  },
];
---

<section class="section layers" aria-labelledby="stack-heading">
  <div class="frame">
    <header class="section-head">
      <p class="section-head__kicker label">
        <span class="signal" aria-hidden="true"></span>
        {t("stack.kicker")}
      </p>
      <h2 id="stack-heading" class="section-title">{t("stack.title")}</h2>
      <p class="section-desc">{t("stack.desc")}</p>
    </header>

    <ol class="strata" role="list">
      {layers.map((layer) => (
        <li class:list={["stratum", { "stratum--north": layer.north }]} aria-current={layer.north ? "true" : undefined}>
          <span class="stratum__level label">{layer.level}</span>
          <span class="stratum__word">{layer.word}</span>
          <div class="stratum__file">
            <h3>{layer.file}</h3>
            <p>{layer.desc}</p>
          </div>
          <span class="stratum__tag label">{layer.tag}</span>
          <span class="stratum__origin label">
            {layer.origin.href ? (
              <a
                href={layer.origin.href}
                target={layer.origin.external ? "_blank" : undefined}
                rel={layer.origin.external ? "noopener noreferrer" : undefined}
              >
                {layer.origin.text}
                <Arrow dir={layer.origin.external ? "up-right" : "right"} />
              </a>
            ) : (
              layer.origin.text
            )}
          </span>
        </li>
      ))}
    </ol>

    <div class="layers__foot">
      <p>{t("stack.summary")}</p>
      <a href={buildLocalizedPath("/compare", lang)} class="text-link">{t("stack.compareLink")}</a>
    </div>
  </div>
</section>

<style>
  .strata {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }

  .stratum {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      "level tag"
      "word word"
      "file file"
      "origin origin";
    align-items: baseline;
    padding-block: 1.5rem 1.6rem;
    border-top: 1px solid var(--rule);
  }

  .stratum__level {
    grid-area: level;
    color: var(--muted);
  }

  .stratum__tag {
    grid-area: tag;
    justify-self: end;
    color: var(--muted);
  }

  .stratum__word {
    grid-area: word;
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 15vw, 4.75rem);
    line-height: 0.92;
    text-transform: uppercase;
    color: var(--fg);
  }

  .stratum__file {
    grid-area: file;
    margin-top: 1rem;
  }

  .stratum__file h3 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.3;
    text-transform: none;
    color: var(--fg);
  }

  .stratum__file p {
    margin: 0.4rem 0 0;
    max-width: 30rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .stratum__origin {
    grid-area: origin;
    margin-top: 1rem;
    color: var(--muted);
  }

  .stratum__origin a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    margin-block: -0.75rem;
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
    transition: color 160ms;
  }

  .stratum__origin a:hover {
    color: var(--fg);
  }

  /* L5 is the figure against the ground: the one inverted stratum. */
  .stratum--north {
    margin-inline: calc(var(--spacing-gutter) * -0.5);
    padding-inline: calc(var(--spacing-gutter) * 0.5);
    background: var(--inv-bg);
    border-top-color: var(--inv-bg);
    --fg: var(--inv-fg);
    --muted: var(--inv-muted);
    color: var(--inv-fg);
  }

  .stratum--north .stratum__word,
  .stratum--north .stratum__tag {
    color: var(--inv-accent);
  }

  .stratum--north .stratum__origin a:hover {
    color: var(--inv-accent);
  }

  .stratum--north :focus-visible {
    outline-color: var(--inv-accent);
  }

  .layers__foot {
    display: grid;
    gap: 1rem 3rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .layers__foot p {
    margin: 0;
    max-width: 40rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .layers__foot .text-link {
    justify-self: start;
    font-size: 0.9375rem;
  }

  @media (min-width: 960px) {
    .stratum {
      grid-template-columns: 4rem minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3fr);
      grid-template-areas:
        "level word file tag"
        "level word file origin";
      grid-template-rows: auto 1fr;
      align-items: start;
      column-gap: 2rem;
      padding-block: 1.75rem;
    }

    .stratum__level {
      padding-top: 0.35rem;
    }

    .stratum__word {
      margin: 0;
      font-size: clamp(3.25rem, 5.6vw, 5.5rem);
    }

    .stratum__file {
      margin: 0;
      padding-top: 0.2rem;
    }

    .stratum__tag {
      justify-self: end;
      padding-top: 0.35rem;
    }

    .stratum__origin {
      align-self: end;
      justify-self: end;
      margin: 0;
      text-align: right;
    }

    .layers__foot {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: start;
    }

    .layers__foot .text-link {
      justify-self: end;
      margin-top: -0.6rem;
    }
  }
</style>
