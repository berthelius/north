---
import CopyButton from "../interactive/CopyButton.astro";
import { useTranslations } from "../../data/locales";
import type { Language } from "../../lib/i18n";

interface Props {
  lang?: Language;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const badgeMarkdown = `[![NORTH.md](https://northfile.dev/badge.svg)](https://northfile.dev)`;
const snippetId = "badge-snippet";
---

<section
  class="badge-section mx-auto max-w-[var(--max-prose,72ch)] px-[var(--spacing-gutter)] py-[var(--spacing-section)] border-t border-[var(--rule)]"
  aria-labelledby="badge-heading"
>
  <h2
    id="badge-heading"
    class="font-display text-[clamp(1.75rem,4vw,2.75rem)] tracking-[0.02em] text-[var(--fg)] uppercase"
  >
    {t("badge.title")}
  </h2>
  <p class="mt-3 max-w-[52ch] text-[var(--muted)] leading-[1.65]">
    {t("badge.desc")}
  </p>

  <!-- Badge preview -->
  <div class="mt-8 flex items-center gap-4">
    <img
      src="/badge.svg"
      alt="NORTH.md badge"
      width="96"
      height="20"
      loading="lazy"
      decoding="async"
    />
    <span class="text-sm text-[var(--muted)]">
      {t("badge.linksBack")} <span class="font-mono text-[0.9em] text-[var(--fg)]"
        >northfile.dev</span
      >
    </span>
  </div>

  <!-- Copy snippet -->
  <div
    class="mt-6 flex items-center gap-3 rounded-md border border-[var(--rule)] bg-[var(--color-stone-900,#1c1917)] px-4 py-3"
    role="group"
    aria-label="Badge markdown snippet"
  >
    <code
      id={snippetId}
      tabindex="0"
      class="flex-1 font-mono text-xs text-[var(--color-stone-100,#f5f5f4)] overflow-x-auto whitespace-nowrap focus-visible:outline-1 focus-visible:outline-[var(--accent)]"
      aria-label="Badge markdown code"
    >{badgeMarkdown}</code>
    <CopyButton
      target={`#${snippetId}`}
      onDark
      label={t("badge.copy")}
      successLabel={t("badge.copied")}
    />
  </div>
</section>
