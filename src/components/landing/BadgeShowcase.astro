---
import CopyButton from "../interactive/CopyButton.astro";
import { useTranslations } from "../../data/locales";
import type { Language } from "../../lib/i18n";

interface Props {
  lang?: Language;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const badgeMarkdown = `[![NORTH.md](https://northfile.dev/badge.svg)](https://northfile.dev)`;
const snippetId = "badge-snippet";
---

<section class="section badge" aria-labelledby="badge-heading">
  <div class="frame badge__grid">
    <div>
      <h2 id="badge-heading" class="section-title">{t("badge.title")}</h2>
      <p class="section-desc badge__desc">{t("badge.desc")}</p>
    </div>

    <div class="badge__specimen">
      <div class="badge__plate">
        <img src="/badge.svg" alt="NORTH.md badge" width="96" height="20" loading="lazy" decoding="async" />
        <span class="badge__caption label">
          {t("badge.linksBack")} <span class="badge__host">northfile.dev</span>
        </span>
      </div>

      <div class="badge__snippet" role="group" aria-label="Badge markdown snippet">
        <code id={snippetId} tabindex="0" aria-label="Badge markdown code">{badgeMarkdown}</code>
        <CopyButton target={`#${snippetId}`} onDark label={t("badge.copy")} successLabel={t("badge.copied")} />
      </div>
    </div>
  </div>
</section>

<style>
  .badge__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
  }

  .badge__desc {
    margin-top: 1.25rem;
  }

  /* The badge shown as a specimen: drawn at twice its size on a ruled plate. */
  .badge__plate {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border: 1px solid var(--rule);
    border-bottom: 0;
  }

  .badge__plate img {
    display: block;
    width: 192px;
    height: 40px;
  }

  .badge__caption {
    color: var(--muted);
  }

  .badge__host {
    color: var(--fg);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .badge__snippet {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.5rem 0.5rem 1.15rem;
    background: var(--ink-bg);
    border: 1px solid var(--ink-rule);
  }

  .badge__snippet code {
    flex: 1;
    min-width: 0;
    padding-block: 0.35rem;
    overflow-wrap: anywhere;
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--ink-fg);
  }

  .badge__snippet code:focus-visible {
    outline-color: var(--ink-accent);
    outline-offset: 2px;
  }

  @media (min-width: 960px) {
    .badge__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
    }
  }
</style>
