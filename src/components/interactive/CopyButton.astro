---
/**
 * CopyButton: copies text to the clipboard.
 *
 * Props:
 *   value        text to copy directly (takes priority over target)
 *   target       CSS selector; copies the textContent of the matched element
 *   label        button label (default: "Copy")
 *   successLabel label shown on success (default: "Copied!")
 *   onDark       render for the ink surface so text keeps AA contrast
 */

interface Props {
  value?: string;
  target?: string;
  label?: string;
  successLabel?: string;
  onDark?: boolean;
  class?: string;
}

const {
  value,
  target,
  label = "Copy",
  successLabel = "Copied!",
  onDark = false,
  class: className = "",
} = Astro.props;
---

<button
  type="button"
  class:list={["copy-btn", "label", { "copy-btn--dark": onDark }, className]}
  aria-label={label}
  data-copy-value={value ?? ""}
  data-copy-target={target ?? ""}
  data-label={label}
  data-success-label={successLabel}
>
  <svg class="copy-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none">
    <path d="M5.5 5.5h8v8h-8zM10.5 5.5v-3h-8v8h3" stroke="currentColor" stroke-width="1.25"></path>
  </svg>
  <svg class="check-icon hidden" aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none">
    <path d="M2.5 8.5l3.5 3.5 7.5-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
  </svg>
  <span class="copy-label">{label}</span>
</button>

<style>
  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.25rem;
    padding: 0 0.8rem;
    background: transparent;
    color: var(--muted);
    border: 1px solid var(--rule);
    cursor: pointer;
    user-select: none;
    transition:
      color 160ms,
      border-color 160ms;
  }

  .copy-btn:hover {
    color: var(--fg);
    border-color: var(--fg);
  }

  .copy-btn--dark {
    color: var(--ink-muted);
    border-color: var(--ink-rule);
  }

  .copy-btn--dark:hover {
    color: var(--ink-fg);
    border-color: var(--ink-fg);
  }

  .copy-btn--dark:focus-visible {
    outline-color: var(--ink-accent);
  }

  .copy-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
  }

  .copy-btn svg {
    flex-shrink: 0;
  }
</style>

<script>
  // Initialise all CopyButton instances on the page (once per page load).
  function initCopyButtons(): void {
    const supportsClipboard = typeof navigator !== "undefined" && "clipboard" in navigator;

    document.querySelectorAll<HTMLButtonElement>("button.copy-btn").forEach((btn) => {
      if (btn.dataset.copyInit === "1") return;
      btn.dataset.copyInit = "1";

      if (!supportsClipboard) {
        btn.disabled = true;
        btn.title = "Clipboard API unavailable in this context";
        return;
      }

      btn.addEventListener("click", async () => {
        let text = btn.dataset.copyValue ?? "";

        if (!text && btn.dataset.copyTarget) {
          const el = document.querySelector(btn.dataset.copyTarget);
          text = el?.textContent?.trim() ?? "";
        }

        if (!text) return;

        try {
          await navigator.clipboard.writeText(text);

          const label = btn.querySelector<HTMLElement>(".copy-label");
          const copyIcon = btn.querySelector<SVGElement>(".copy-icon");
          const checkIcon = btn.querySelector<SVGElement>(".check-icon");

          if (label) label.textContent = btn.dataset.successLabel ?? "Copied!";
          copyIcon?.classList.add("hidden");
          checkIcon?.classList.remove("hidden");
          btn.setAttribute("aria-label", btn.dataset.successLabel ?? "Copied!");

          setTimeout(() => {
            if (label) label.textContent = btn.dataset.label ?? "Copy";
            copyIcon?.classList.remove("hidden");
            checkIcon?.classList.add("hidden");
            btn.setAttribute("aria-label", btn.dataset.label ?? "Copy");
          }, 2000);
        } catch {
          // Clipboard write failed: degrade silently.
          btn.disabled = true;
        }
      });
    });
  }

  // Run on initial load and after any View Transition.
  initCopyButtons();
  document.addEventListener("astro:page-load", initCopyButtons);
</script>
