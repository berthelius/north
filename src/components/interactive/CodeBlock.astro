---
/**
 * CodeBlock: code on an ink surface, with a language label and CopyButton.
 * Markdown gets a light, build-time highlight (structure in the bright tone,
 * syntax and placeholders muted, section numbers in the signal colour). The
 * spans carry no extra text, so the copied text is the source, byte for byte.
 *
 * `lang` is the code language; `locale` is the page language for the UI labels.
 *
 * Usage:
 *   <CodeBlock code={`# Example`} lang="markdown" locale="es" />
 */

import CopyButton from "./CopyButton.astro";
import { useTranslations } from "../../data/locales";
import type { Language } from "../../lib/i18n";

interface Props {
  code: string;
  lang?: string;
  locale?: Language;
  class?: string;
}

const { code, lang = "markdown", locale = "en", class: className = "" } = Astro.props;
const t = useTranslations(locale);

// Unique ID per instance for the copy-target selector.
const id = `cb-${Math.random().toString(36).slice(2, 9)}`;

type Token = { text: string; kind?: "mark" | "num" | "head" | "dim" };

function tokenize(line: string): Token[] {
  if (lang !== "markdown") return [{ text: line }];
  if (/^<!--.*-->$/.test(line) || /^\[.*\]$/.test(line)) return [{ text: line, kind: "dim" }];
  const heading = line.match(/^(#{1,6} )(\d+\. )?(.*)$/);
  if (heading) {
    const [, mark, num, rest] = heading;
    return [{ text: mark, kind: "mark" }, ...(num ? [{ text: num, kind: "num" as const }] : []), { text: rest, kind: "head" }];
  }
  if (line.startsWith("|")) {
    return line
      .split(/(\|)/)
      .filter(Boolean)
      .map((text) => ({ text, kind: text === "|" || /^-+$/.test(text) ? "mark" : undefined }));
  }
  return [{ text: line }];
}

const lines = code.split("\n").map(tokenize);
---

<div class:list={["code-block", className]}>
  <div class="code-block__bar">
    <span class="label code-block__lang" aria-hidden="true">{lang}</span>
    <CopyButton target={`#${id}`} onDark lang={locale} />
  </div>
  <pre id={id} tabindex="0" aria-label={t("code.block").replace("{lang}", lang)}><code>{lines.map((tokens, i) => <Fragment>{tokens.map((tok) => (tok.kind ? <span class={`tk-${tok.kind}`}>{tok.text}</span> : tok.text))}{i < lines.length - 1 ? "\n" : ""}</Fragment>)}</code></pre>
</div>

<style>
  .code-block {
    background: var(--ink-bg);
    color: var(--ink-fg);
    border: 1px solid var(--ink-rule);
  }

  .code-block__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.5rem 0.5rem 1.15rem;
    border-bottom: 1px solid var(--ink-rule);
  }

  .code-block__lang {
    color: var(--ink-muted);
    user-select: none;
  }

  pre {
    margin: 0;
    padding: 1.35rem 1.15rem 1.5rem;
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.75;
    white-space: pre;
    background: transparent;
    scrollbar-color: var(--ink-rule) transparent;
  }

  pre code {
    font-size: inherit;
  }

  .tk-mark,
  .tk-dim {
    color: var(--ink-muted);
  }

  .tk-num {
    color: var(--ink-accent);
  }

  .tk-head {
    color: #ffffff;
    font-weight: 700;
  }

  pre:focus-visible {
    outline-offset: -2px;
  }
</style>
