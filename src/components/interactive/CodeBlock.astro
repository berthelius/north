---
/**
 * CodeBlock — displays code with a language label and CopyButton.
 *
 * Props:
 *   code     — the code content to display
 *   lang     — language label (default: "markdown")
 *   variant  — "dark" | "light" (default: "dark")
 *   class    — additional class names for the outer wrapper
 *
 * Usage:
 *   <CodeBlock code={`# Example`} lang="markdown" />
 */

import CopyButton from './CopyButton.astro';

interface Props {
  code: string;
  lang?: string;
  variant?: 'dark' | 'light';
  class?: string;
}

const {
  code,
  lang = 'markdown',
  variant = 'dark',
  class: className = '',
} = Astro.props;

// Unique ID per instance for the copy-target selector.
const id = `cb-${Math.random().toString(36).slice(2, 9)}`;

const wrapperBg = variant === 'dark'
  ? 'bg-[var(--color-stone-900,#1c1917)]'
  : 'bg-[var(--color-stone-100,#f5f5f4)]';

const labelColor = variant === 'dark'
  ? 'text-[var(--color-stone-400,#a8a29e)]'
  : 'text-[var(--color-stone-600,#57534e)]';

const codeColor = variant === 'dark'
  ? 'text-[var(--color-stone-100,#f5f5f4)]'
  : 'text-[var(--color-stone-900,#1c1917)]';
---

<div
  class:list={[
    'code-block relative rounded-md overflow-hidden',
    wrapperBg,
    className,
  ]}
>
  <!-- Top bar: lang label + copy button -->
  <div
    class:list={[
      'flex items-center justify-between',
      'px-4 py-2',
      'border-b',
      variant === 'dark'
        ? 'border-[var(--color-stone-700,#44403c)]'
        : 'border-[var(--color-stone-200,#e7e5e4)]',
    ]}
  >
    <span
      class:list={[
        'text-xs font-mono uppercase tracking-widest select-none',
        labelColor,
      ]}
      aria-hidden="true"
    >{lang}</span>
    <CopyButton
      target={`#${id}`}
      label="Copy"
      successLabel="Copied!"
    />
  </div>

  <!-- Code content -->
  <pre
    id={id}
    class:list={[
      'overflow-x-auto',
      'p-4',
      'm-0',
      'text-sm leading-relaxed',
      'font-mono',
      'whitespace-pre',
      codeColor,
      'bg-transparent',
    ]}
    tabindex="0"
    aria-label={`${lang} code block`}
  ><code>{code}</code></pre>
</div>

<style>
  /* Scrollbar styling for dark variant */
  .code-block pre::-webkit-scrollbar {
    height: 4px;
  }
  .code-block pre::-webkit-scrollbar-track {
    background: transparent;
  }
  .code-block pre::-webkit-scrollbar-thumb {
    background: var(--color-stone-700, #44403c);
    border-radius: 2px;
  }
</style>
