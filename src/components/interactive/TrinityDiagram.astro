---
/**
 * TrinityDiagram — visual "agent context trinity" diagram.
 *
 * Renders three vertical pillars:
 *   CLAUDE.md / AGENTS.md  — How (rules, gates, workflow)
 *   SOUL.md                — Who (identity, voice, values)
 *   NORTH.md               — Why + How Far (purpose, ambition)
 *
 * NORTH.md is highlighted with the rust accent.
 * Pure CSS + inline SVG — no JS, no images.
 * Accessible: roles, aria-labels, reduced-motion aware.
 *
 * Props:
 *   class — additional class names for the outer element
 */

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<figure
  class:list={['trinity-diagram', className]}
  role="img"
  aria-label="The 5-layer agent governance stack: CONSTITUTION.md (limits), AGENTS.md (how), design.md (look), SOUL.md (who), and NORTH.md (why and how far)."
>
  <div class="trinity-pillars">

    <!-- Pillar 1: CONSTITUTION.md -->
    <div class="pillar pillar--limits" aria-hidden="true">
      <div class="pillar__inner">
        <div class="pillar__icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="pillar__content">
          <p class="pillar__file">CONSTITUTION.md</p>
          <p class="pillar__label">Limits</p>
          <p class="pillar__desc">Safety invariants &amp; red lines</p>
        </div>
      </div>
    </div>

    <!-- Connector -->
    <div class="pillar-connector" aria-hidden="true"></div>

    <!-- Pillar 2: AGENTS.md / CLAUDE.md -->
    <div class="pillar pillar--how" aria-hidden="true">
      <div class="pillar__inner">
        <div class="pillar__icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/>
            <path d="M7 8h10M7 12h10M7 16h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="pillar__content">
          <p class="pillar__file">AGENTS.md</p>
          <p class="pillar__label">How</p>
          <p class="pillar__desc">Rules, gates &amp; workflow</p>
        </div>
      </div>
    </div>

    <!-- Connector -->
    <div class="pillar-connector" aria-hidden="true"></div>

    <!-- Pillar 3: design.md -->
    <div class="pillar pillar--look" aria-hidden="true">
      <div class="pillar__inner">
        <div class="pillar__icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
            <path d="M12 3a9 9 0 0 1 0 18v-9h9" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </div>
        <div class="pillar__content">
          <p class="pillar__file">design.md</p>
          <p class="pillar__label">Look</p>
          <p class="pillar__desc">UI tokens &amp; visual system</p>
        </div>
      </div>
    </div>

    <!-- Connector -->
    <div class="pillar-connector" aria-hidden="true"></div>

    <!-- Pillar 4: SOUL.md -->
    <div class="pillar pillar--who" aria-hidden="true">
      <div class="pillar__inner">
        <div class="pillar__icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.5"/>
            <path d="M4 20c0-4 3.582-7 8-7s8 3 8 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="pillar__content">
          <p class="pillar__file">SOUL.md</p>
          <p class="pillar__label">Who</p>
          <p class="pillar__desc">Identity, voice &amp; values</p>
        </div>
      </div>
    </div>

    <!-- Connector -->
    <div class="pillar-connector" aria-hidden="true"></div>

    <!-- Pillar 5: NORTH.md (Apex highlighted) -->
    <div class="pillar pillar--north pillar--accent" aria-hidden="true">
      <div class="pillar__inner">
        <div class="pillar__icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 2L12 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M12 2L7 9M12 2L17 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="pillar__content">
          <p class="pillar__file">NORTH.md</p>
          <p class="pillar__label">Why &amp; How Far</p>
          <p class="pillar__desc">Purpose &amp; arbitration</p>
        </div>
      </div>
      <!-- Accent marker -->
      <div class="pillar__badge">Apex</div>
    </div>

  </div>

  <figcaption class="trinity-caption">
    The five modular layers of the modern agent stack.
    <strong>NORTH.md</strong> is the apex arbitration layer.
  </figcaption>
</figure>

<style>
  .trinity-diagram {
    margin: 0;
    padding: 0;
    width: 100%;
  }

  .trinity-pillars {
    display: flex;
    align-items: stretch;
    gap: 0;
    width: 100%;
    border: 1px solid var(--rule, #e7e5e4);
    border-radius: 12px;
    overflow: hidden;
  }

  /* Pillar */
  .pillar {
    flex: 1 1 0;
    position: relative;
    padding: clamp(1.25rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    background: var(--bg, #fafaf9);
    transition: background 200ms ease;
  }

  .pillar + .pillar {
    border-left: 1px solid var(--rule, #e7e5e4);
  }

  .pillar__inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .pillar__icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: var(--color-stone-100, #f5f5f4);
    color: var(--color-stone-600, #57534e);
    flex-shrink: 0;
  }

  @media (prefers-color-scheme: dark) {
    .pillar__icon {
      background: var(--color-stone-800, #292524);
      color: var(--color-stone-400, #a8a29e);
    }
  }

  .pillar__content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .pillar__file {
    margin: 0;
    font-family: var(--font-mono, ui-monospace, 'SF Mono', Menlo, monospace);
    font-size: clamp(0.7rem, 1.5vw, 0.8125rem);
    font-weight: 600;
    color: var(--fg, #0a0a0a);
    line-height: 1.3;
  }

  .pillar__file--secondary {
    color: var(--muted, #78716c);
    font-weight: 400;
  }

  .pillar__label {
    margin: 0.5rem 0 0;
    font-family: var(--font-display, ui-serif, Georgia, serif);
    font-size: clamp(1rem, 2vw, 1.375rem);
    font-weight: 400;
    color: var(--fg, #0a0a0a);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .pillar__desc {
    margin: 0.25rem 0 0;
    font-size: clamp(0.7rem, 1.5vw, 0.8125rem);
    color: var(--muted, #78716c);
    line-height: 1.4;
  }

  /* Accent pillar (NORTH.md) */
  .pillar--accent {
    background: color-mix(in srgb, #c2410c 6%, var(--bg, #fafaf9));
    border-left-color: color-mix(in srgb, #c2410c 30%, var(--rule, #e7e5e4)) !important;
  }

  .pillar--accent .pillar__icon {
    background: color-mix(in srgb, #c2410c 12%, var(--bg, #fafaf9));
    color: #c2410c;
  }

  .pillar--accent .pillar__file {
    color: #c2410c;
  }

  .pillar--accent .pillar__label {
    color: #c2410c;
  }

  @media (prefers-color-scheme: dark) {
    .pillar--accent {
      background: color-mix(in srgb, #c2410c 8%, var(--color-stone-950, #0c0a09));
    }
    .pillar--accent .pillar__icon {
      background: color-mix(in srgb, #c2410c 15%, var(--color-stone-900, #1c1917));
      color: #f97316;
    }
    .pillar--accent .pillar__file,
    .pillar--accent .pillar__label {
      color: #f97316;
    }
  }

  /* Badge */
  .pillar__badge {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.2em 0.6em;
    border-radius: 4px;
    font-size: 0.6875rem;
    font-family: var(--font-mono, ui-monospace, 'SF Mono', Menlo, monospace);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: #c2410c;
    color: #fff;
    width: fit-content;
  }

  @media (prefers-color-scheme: dark) {
    .pillar__badge {
      background: #f97316;
      color: #0c0a09;
    }
  }

  /* Connector (hidden in horizontal layout — the border-left handles separation) */
  .pillar-connector {
    display: none;
  }

  /* Caption */
  .trinity-caption {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--muted, #78716c);
    text-align: center;
    line-height: 1.5;
  }

  .trinity-caption strong {
    color: var(--fg, #0a0a0a);
  }

  /* Tablet/Mobile: stack vertically */
  @media (max-width: 840px) {
    .trinity-pillars {
      flex-direction: column;
      border-radius: 10px;
    }

    .pillar + .pillar {
      border-left: none;
      border-top: 1px solid var(--rule, #e7e5e4);
    }

    .pillar--accent {
      border-top-color: color-mix(in srgb, #c2410c 30%, var(--rule, #e7e5e4)) !important;
    }
  }

  /* Entrance animation */
  @keyframes pillar-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .pillar--how {
    animation: pillar-rise 0.45s var(--ease-out-quart, cubic-bezier(0.25, 1, 0.5, 1)) 0.05s both;
  }
  .pillar--who {
    animation: pillar-rise 0.45s var(--ease-out-quart, cubic-bezier(0.25, 1, 0.5, 1)) 0.15s both;
  }
  .pillar--north {
    animation: pillar-rise 0.45s var(--ease-out-quart, cubic-bezier(0.25, 1, 0.5, 1)) 0.25s both;
  }

  /* Respect prefers-reduced-motion — global.css already sets 0.001ms,
     but explicit here for component isolation */
  @media (prefers-reduced-motion: reduce) {
    .pillar--how,
    .pillar--who,
    .pillar--north {
      animation: none;
    }
  }
</style>
