---
import Base from "../../layouts/Base.astro";
import { renderSpec } from "../../lib/spec";
import type { Language } from "../../lib/i18n";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const es = lang === "es";
const spec = await renderSpec(es ? "SPEC-ES.md" : "SPEC.md");

const t = es
  ? {
      title: "Especificación — NORTH.md",
      description:
        "La especificación de NORTH.md: siete secciones que dan criterio a tus agentes de IA donde acaba el prompt.",
      headline: "Especificación NORTH.md (Español)",
      ld: "NORTH.md es una convención abierta: un archivo markdown que declara el propósito, la ambición y los trade-offs precalculados de un proyecto para personas y agentes de IA.",
      toc: "Tabla de contenidos",
      tocMobile: "Tabla de contenidos (móvil)",
      contents: "Contenido",
      authors: "Autor",
      licence: "Licencia",
      download: "Descargar spec.md (ES)",
      copied: "Copiado",
      copy: "Copiar",
    }
  : {
      title: "Specification — NORTH.md",
      description:
        "The NORTH.md specification. Seven sections that give your AI agents judgment when the prompt runs out.",
      headline: "NORTH.md Specification",
      ld: "NORTH.md is an open convention: one markdown file that declares a project's purpose, ambition and precomputed trade-offs for humans and AI coding agents.",
      toc: "Table of contents",
      tocMobile: "Table of contents (mobile)",
      contents: "Contents",
      authors: "Authors",
      licence: "Licence",
      download: "Download spec.md",
      copied: "Copied",
      copy: "Copy",
    };

const base = es ? "/es/spec" : "/spec";
const url = `https://northfile.dev${base}`;
// TOC: every H2, plus the seven numbered sections; changelog entries stay out.
const sections = spec.headings.filter((h) => h.depth === 2 || /^\d+\./.test(h.text));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: t.headline,
  description: t.ld,
  version: spec.version,
  datePublished: spec.date,
  dateModified: spec.date,
  inLanguage: es ? "es" : "en",
  author: {
    "@type": "Person",
    "@id": "https://www.brthls.com/about#person",
    name: "Viktor Berthelius",
    url: "https://www.brthls.com/about",
  },
  publisher: {
    "@type": "Organization",
    name: "BRTHLS",
    "@id": "https://www.brthls.com/#organization",
    url: "https://www.brthls.com",
  },
  license: "https://opensource.org/licenses/MIT",
  url,
  mainEntityOfPage: url,
};
---

<Base title={t.title} description={t.description} canonical={url} lang={lang} ogImage="/og/spec.png">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="spec-layout frame">
    <!-- Sticky TOC — desktop left column -->
    <aside class="toc-aside" aria-label={t.toc}>
      <nav class="toc-nav" aria-label={t.toc}>
        <p class="toc-heading">{t.contents}</p>
        <ol class="toc-list">
          {
            sections.map((s) => (
              <li>
                <a href={`#${s.id}`} class="toc-link" data-section={s.id}>
                  {s.label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </aside>

    <!-- Mobile TOC — collapsible -->
    <nav class="toc-mobile" aria-label={t.tocMobile}>
      <details>
        <summary class="toc-mobile-summary">
          <span>{t.contents}</span>
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M4 6l4 4 4-4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        </summary>
        <div>
          <ol class="toc-mobile-list">
            {
              sections.map((s) => (
                <li>
                  <a href={`#${s.id}`} class="toc-link">
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ol>
        </div>
      </details>
    </nav>

    <!-- Main content -->
    <main class="spec-main" id="main-content">
      <header class="spec-header">
        <p class="spec-eyebrow label">
          <span class="signal" aria-hidden="true"></span>
          <span class="version-badge">v{spec.version}</span>
        </p>
        <h1 class="spec-title">{spec.title}</h1>
        <div class="spec-meta">
          <span>{t.authors}: <a href="https://www.brthls.com" class="spec-link">Viktor Berthelius</a> (BRTHLS)</span>
          <span class="meta-sep" aria-hidden="true">·</span>
          <span>{t.licence}: MIT</span>
          <span class="meta-sep" aria-hidden="true">·</span>
          <time datetime={spec.date}>{spec.date}</time>
        </div>
        <div class="spec-actions">
          <a href={`${base}.md`} class="action-link" download>
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M8 2v9M4 8l4 4 4-4M3 14h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {t.download}
          </a>
          <a href="https://github.com/berthelius/north" class="action-link">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M8 1C4.134 1 1 4.134 1 8c0 3.09 2.003 5.715 4.781 6.635.35.065.477-.151.477-.337 0-.166-.006-.604-.01-1.187-1.947.423-2.357-.94-2.357-.94-.318-.809-.777-1.025-.777-1.025-.635-.434.048-.425.048-.425.702.049 1.071.72 1.071.72.624 1.069 1.636.76 2.035.581.063-.451.244-.76.444-.935-1.554-.177-3.188-.777-3.188-3.459 0-.764.273-1.389.72-1.88-.072-.177-.312-.89.069-1.855 0 0 .587-.188 1.923.716A6.703 6.703 0 018 4.745c.595.003 1.193.08 1.752.236 1.334-.904 1.92-.716 1.92-.716.382.965.142 1.678.07 1.855.448.491.72 1.116.72 1.88 0 2.689-1.637 3.28-3.197 3.453.251.217.475.644.475 1.299 0 .937-.009 1.692-.009 1.922 0 .188.126.406.48.337C12.998 13.714 15 11.09 15 8c0-3.866-3.134-7-7-7z" fill="currentColor"/>
            </svg>
            GitHub
          </a>
        </div>
      </header>

      <div class="spec-body" set:html={spec.html} />
      <script
        is:inline
        type="application/json"
        id="spec-sections"
        data-copied={t.copied}
        data-copy={t.copy}
        set:html={JSON.stringify(spec.sections).replace(/</g, "\\u003c")}
      />

      <footer class="spec-footer">
        <p>
          MIT &copy; <a href="https://www.brthls.com" class="spec-link">Viktor Berthelius</a>
          <span class="meta-sep" aria-hidden="true">·</span>
          <a href="https://github.com/berthelius/north" class="spec-link">GitHub</a>
          {
            !es && (
              <>
                <span class="meta-sep" aria-hidden="true">·</span>
                <a href="/changelog" class="spec-link">Changelog</a>
              </>
            )
          }
        </p>
      </footer>
    </main>
  </div>
</Base>

<style is:global>
  /* Layout: contents rail on the left, the document on a reading measure. */
  .spec-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-height: 100dvh;
  }

  @media (min-width: 1024px) {
    .spec-layout {
      grid-template-columns: 15rem minmax(0, 1fr);
      column-gap: clamp(3rem, 6vw, 6rem);
    }
  }

  /* Contents rail (desktop) */
  .toc-aside {
    display: none;
  }

  @media (min-width: 1024px) {
    .toc-aside {
      display: block;
      position: sticky;
      top: var(--header-h);
      height: calc(100dvh - var(--header-h));
      overflow-y: auto;
      padding: 3.5rem 0 3rem;
      scrollbar-width: none;
    }
  }

  .toc-heading {
    margin: 0 0 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .toc-list,
  .toc-mobile-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--rule);
  }

  .toc-link {
    display: block;
    margin-left: -1px;
    padding: 0.4rem 0 0.4rem 1rem;
    border-left: 2px solid transparent;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--muted);
    text-decoration: none;
    transition:
      color 160ms,
      border-color 160ms;
  }

  .toc-link:hover {
    color: var(--fg);
    border-left-color: var(--rule);
  }

  .toc-link.active {
    color: var(--fg);
    border-left-color: var(--accent);
  }

  .toc-link:focus-visible {
    outline-offset: -2px;
  }

  /* Contents (mobile): a ruled disclosure under the header */
  .toc-mobile {
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 1024px) {
    .toc-mobile {
      display: none;
    }
  }

  .toc-mobile-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--fg);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .toc-mobile-summary::-webkit-details-marker {
    display: none;
  }

  .toc-mobile-summary svg {
    transition: transform 200ms var(--ease-out-quart);
  }

  details[open] .toc-mobile-summary svg {
    transform: rotate(180deg);
  }

  .toc-mobile-list {
    margin-bottom: 1.25rem;
  }

  .toc-mobile-list .toc-link {
    padding-block: 0.55rem;
    font-size: 0.875rem;
  }

  /* The document */
  .spec-main {
    width: 100%;
    max-width: 46rem;
    min-width: 0;
    padding: clamp(2.5rem, 6vw, 3.5rem) 0 clamp(4rem, 8vw, 6rem);
  }

  /* No rule of its own: the first part heading draws it. */
  .spec-header {
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .spec-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 1.5rem;
    color: var(--muted);
  }

  .spec-title {
    margin: 0 0 1.5rem;
    font-size: clamp(2.75rem, 9vw, 5.75rem);
    letter-spacing: 0;
  }

  .spec-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin-bottom: 1.75rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .meta-sep {
    color: var(--muted);
  }

  .spec-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .action-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--fg);
    text-decoration: none;
    border: 1px solid var(--fg);
    transition:
      color 160ms,
      background-color 160ms;
  }

  .action-link:hover {
    color: var(--bg);
    background: var(--fg);
  }

  /* Body typography */
  .spec-body {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 3.5rem);
    font-size: 1.0625rem;
  }

  .spec-body section {
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .spec-body p {
    margin: 0 0 1em;
    line-height: 1.7;
  }

  .spec-body p:last-child {
    margin-bottom: 0;
  }

  .spec-body ul,
  .spec-body ol {
    margin: 0.75rem 0 1.25rem;
    padding-left: 1.25rem;
    line-height: 1.7;
  }

  .spec-body li {
    margin-bottom: 0.4rem;
    padding-left: 0.25rem;
  }

  .spec-body li::marker {
    color: var(--muted);
  }

  .spec-body strong {
    font-weight: 650;
  }

  .spec-body code {
    padding: 0.1em 0.35em;
    font-size: 0.86em;
    background: var(--surface);
  }

  .spec-body pre {
    margin: 1rem 0 1.25rem;
    padding: 1.25rem 1.35rem;
    max-width: 100%;
    overflow-x: auto;
    background: var(--ink-bg);
    color: var(--ink-fg);
    border: 1px solid var(--ink-rule);
    scrollbar-color: var(--ink-rule) transparent;
  }

  .spec-body pre code {
    padding: 0;
    font-size: 0.8125rem;
    line-height: 1.7;
    background: none;
  }

  .spec-body pre:focus-visible {
    outline-color: var(--ink-accent);
    outline-offset: -2px;
  }

  /* Headings: H2 opens a part under an ink rule; H3 is a numbered section. */
  .section-heading,
  .subsection-heading {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    margin: 0 0 1.25rem;
    letter-spacing: 0.005em;
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .section-heading {
    padding-top: 1.1rem;
    border-top: 1px solid var(--fg);
    font-size: clamp(1.9rem, 4.2vw, 2.75rem);
  }

  .subsection-heading {
    font-size: clamp(1.5rem, 3vw, 1.95rem);
  }

  .section-num {
    flex-shrink: 0;
    min-width: 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--accent);
    transform: translateY(-0.35em);
  }

  /* Copy-section button: quiet until the heading is hovered or focused. */
  .spec-body .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: center;
    min-height: 2rem;
    margin-left: auto;
    padding: 0 0.6rem;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    background: none;
    border: 1px solid transparent;
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 160ms,
      color 160ms,
      border-color 160ms;
  }

  .section-heading:hover .copy-btn,
  .section-heading:focus-within .copy-btn,
  .subsection-heading:hover .copy-btn,
  .subsection-heading:focus-within .copy-btn,
  .spec-body .copy-btn.copied {
    opacity: 1;
  }

  .spec-body .copy-btn:hover {
    color: var(--fg);
    border-color: var(--rule);
  }

  .spec-body .copy-btn.copied {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* Touch screens have no hover: keep the button visible. */
  @media (hover: none) {
    .spec-body .copy-btn {
      opacity: 1;
    }
  }

  /* Blockquotes */
  .spec-body blockquote {
    margin: 1.5rem 0;
    padding: 0.15rem 0 0.15rem 1.35rem;
    border-left: 1px solid var(--accent);
    font-style: normal;
    color: var(--muted);
  }

  .spec-body blockquote em,
  .spec-body blockquote strong {
    color: var(--fg);
    font-style: normal;
  }

  .seven-sections-intro {
    border-top: 1px solid var(--rule);
    padding-top: 0.5rem;
    margin-top: 0.5rem;
  }

  .recommended-note {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.85rem !important;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .recommended-note::before {
    content: "";
    width: 7px;
    height: 7px;
    background: var(--accent);
  }

  /* Tables */
  .table-wrapper {
    margin: 1.25rem 0;
    overflow-x: auto;
    border-top: 1px solid var(--fg);
  }

  .table-wrapper:focus-visible {
    outline-offset: 2px;
  }

  .spec-body table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .spec-body th {
    padding: 0.75rem 1rem 0.75rem 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.09em;
    text-align: left;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--rule);
  }

  .spec-body td {
    padding: 0.8rem 1rem 0.8rem 0;
    vertical-align: top;
    line-height: 1.5;
    border-bottom: 1px solid var(--rule);
  }

  /* Changelog entries inside the spec */
  .changelog-version-inline {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0 0 0.75rem;
    font-size: 1.35rem;
    color: var(--fg);
  }

  .changelog-date-inline {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--muted);
  }

  /* Links */
  .spec-link {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--muted);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition:
      color 160ms,
      text-decoration-color 160ms;
  }

  .spec-link:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  /* Footer */
  .spec-footer {
    margin-top: clamp(3.5rem, 7vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--fg);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .spec-footer p {
    margin: 0;
  }
</style>


<script>
  // Smooth scroll
  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener("click", (e) => {
      const href = (e.currentTarget as HTMLAnchorElement).getAttribute("href");
      if (!href) return;
      const target = document.querySelector(href);
      if (target) {
        e.preventDefault();
        const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
        target.scrollIntoView({ behavior: still ? "auto" : "smooth", block: "start" });
        history.pushState(null, "", href);
      }
    });
  });

  // Active TOC link via IntersectionObserver
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>(".toc-link");
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          tocLinks.forEach((link) => link.classList.remove("active"));
          document
            .querySelector<HTMLAnchorElement>(`.toc-link[href="#${entry.target.id}"]`)
            ?.classList.add("active");
        }
      });
    },
    { rootMargin: "0px 0px -80% 0px", threshold: 0 }
  );
  document.querySelectorAll("h2[id], h3[id]").forEach((h) => observer.observe(h));

  // Copy section button: markdown comes from the rendered SPEC file itself.
  const store = document.getElementById("spec-sections");
  const sectionMarkdown: Record<string, string> = JSON.parse(store?.textContent ?? "{}");
  const copyText = store?.dataset.copy ?? "";
  const copiedText = store?.dataset.copied ?? "";

  document.querySelectorAll<HTMLButtonElement>(".spec-body .copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = sectionMarkdown[btn.dataset.section ?? ""] ?? "";
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const label = btn.querySelector(".copy-label");
        btn.classList.add("copied");
        if (label) label.textContent = copiedText;
        setTimeout(() => {
          btn.classList.remove("copied");
          if (label) label.textContent = copyText;
        }, 2000);
      } catch {
        // Clipboard not available — silent fail
      }
    });
  });
</script>
