---
import Base from "../../layouts/Base.astro";
import { renderSpec } from "../../lib/spec";
import type { Language } from "../../lib/i18n";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const es = lang === "es";
const spec = await renderSpec(es ? "SPEC-ES.md" : "SPEC.md");

const t = es
  ? {
      title: "Especificación — NORTH.md",
      description:
        "La especificación de NORTH.md. Siete secciones pensadas para dar criterio a tus agentes de IA cuando el prompt se termina.",
      headline: "Especificación NORTH.md (Español)",
      ld: "La especificación de NORTH.md en español: siete secciones para declarar el propósito, la ambición y los trade-offs precalculados de un proyecto.",
      toc: "Tabla de contenidos",
      tocMobile: "Tabla de contenidos (móvil)",
      contents: "Contenido",
      authors: "Autor",
      licence: "Licencia",
      download: "Descargar spec.md (ES)",
      copied: "Copiado",
      copy: "Copiar",
    }
  : {
      title: "Specification — NORTH.md",
      description:
        "The NORTH.md specification. Seven sections that give your AI agents judgment when the prompt runs out.",
      headline: "NORTH.md Specification",
      ld: "The specification for NORTH.md: a markdown convention declaring project purpose, ambition, and trade-off defaults for AI coding agents.",
      toc: "Table of contents",
      tocMobile: "Table of contents (mobile)",
      contents: "Contents",
      authors: "Authors",
      licence: "Licence",
      download: "Download spec.md",
      copied: "Copied",
      copy: "Copy",
    };

const base = es ? "/es/spec" : "/spec";
const url = `https://northfile.dev${base}`;
// TOC: every H2, plus the seven numbered sections; changelog entries stay out.
const sections = spec.headings.filter((h) => h.depth === 2 || /^\d+\./.test(h.text));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: t.headline,
  description: t.ld,
  version: spec.version,
  datePublished: spec.date,
  dateModified: spec.date,
  inLanguage: es ? "es" : "en",
  author: {
    "@type": "Person",
    name: "Viktor Berthelius",
    url: "https://brthls.com",
  },
  publisher: {
    "@type": "Organization",
    name: "BRTHLS",
    url: "https://brthls.com",
  },
  license: "https://opensource.org/licenses/MIT",
  url,
  mainEntityOfPage: url,
};
---

<Base title={t.title} description={t.description} canonical={url} lang={lang}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="spec-layout">
    <!-- Sticky TOC — desktop left column -->
    <aside class="toc-aside" aria-label={t.toc}>
      <nav class="toc-nav" aria-label={t.toc}>
        <p class="toc-heading">{t.contents}</p>
        <ol class="toc-list">
          {
            sections.map((s) => (
              <li>
                <a href={`#${s.id}`} class="toc-link" data-section={s.id}>
                  {s.label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </aside>

    <!-- Mobile TOC — collapsible -->
    <nav class="toc-mobile" aria-label={t.tocMobile}>
      <details>
        <summary class="toc-mobile-summary">
          <span>{t.contents}</span>
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M4 6l4 4 4-4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        </summary>
        <div>
          <ol class="toc-mobile-list">
            {
              sections.map((s) => (
                <li>
                  <a href={`#${s.id}`} class="toc-link">
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ol>
        </div>
      </details>
    </nav>

    <!-- Main content -->
    <main class="spec-main" id="main-content">
      <header class="spec-header">
        <p class="spec-eyebrow">
          <span class="version-badge">v{spec.version}</span>
        </p>
        <h1 class="spec-title">{spec.title}</h1>
        <div class="spec-meta">
          <span>{t.authors}: <a href="https://brthls.com" class="spec-link">Viktor Berthelius</a> (BRTHLS)</span>
          <span class="meta-sep" aria-hidden="true">·</span>
          <span>{t.licence}: MIT</span>
          <span class="meta-sep" aria-hidden="true">·</span>
          <time datetime={spec.date}>{spec.date}</time>
        </div>
        <div class="spec-actions">
          <a href={`${base}.md`} class="action-link" download>
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M8 2v9M4 8l4 4 4-4M3 14h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {t.download}
          </a>
          <a href="https://github.com/berthelius/north" class="action-link">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M8 1C4.134 1 1 4.134 1 8c0 3.09 2.003 5.715 4.781 6.635.35.065.477-.151.477-.337 0-.166-.006-.604-.01-1.187-1.947.423-2.357-.94-2.357-.94-.318-.809-.777-1.025-.777-1.025-.635-.434.048-.425.048-.425.702.049 1.071.72 1.071.72.624 1.069 1.636.76 2.035.581.063-.451.244-.76.444-.935-1.554-.177-3.188-.777-3.188-3.459 0-.764.273-1.389.72-1.88-.072-.177-.312-.89.069-1.855 0 0 .587-.188 1.923.716A6.703 6.703 0 018 4.745c.595.003 1.193.08 1.752.236 1.334-.904 1.92-.716 1.92-.716.382.965.142 1.678.07 1.855.448.491.72 1.116.72 1.88 0 2.689-1.637 3.28-3.197 3.453.251.217.475.644.475 1.299 0 .937-.009 1.692-.009 1.922 0 .188.126.406.48.337C12.998 13.714 15 11.09 15 8c0-3.866-3.134-7-7-7z" fill="currentColor"/>
            </svg>
            GitHub
          </a>
        </div>
      </header>

      <div class="spec-body" set:html={spec.html} />
      <script
        is:inline
        type="application/json"
        id="spec-sections"
        data-copied={t.copied}
        data-copy={t.copy}
        set:html={JSON.stringify(spec.sections).replace(/</g, "\\u003c")}
      />

      <footer class="spec-footer">
        <p>
          MIT &copy; <a href="https://brthls.com" class="spec-link">Viktor Berthelius</a>
          <span class="meta-sep" aria-hidden="true">·</span>
          <a href="https://github.com/berthelius/north" class="spec-link">GitHub</a>
          {
            !es && (
              <>
                <span class="meta-sep" aria-hidden="true">·</span>
                <a href="/changelog" class="spec-link">Changelog</a>
              </>
            )
          }
        </p>
      </footer>
    </main>
  </div>
</Base>

<style is:global>
  /* Layout */
  .spec-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-height: 100dvh;
    overflow-x: hidden;
  }

  @media (min-width: 1024px) {
    .spec-layout {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 0;
    }
  }

  /* TOC — desktop */
  .toc-aside {
    display: none;
  }

  @media (min-width: 1024px) {
    .toc-aside {
      display: block;
      position: sticky;
      top: 0;
      height: 100dvh;
      overflow-y: auto;
      padding: 3rem 1.5rem 3rem 2rem;
      border-right: 1px solid var(--rule);
    }
  }

  .toc-nav {
    /* natural scroll */
  }

  .toc-heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin: 0 0 1rem;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .toc-link {
    display: block;
    font-size: var(--text-sm);
    color: var(--muted);
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    transition: color 0.15s, background 0.15s;
    line-height: 1.4;
  }

  .toc-link:hover,
  .toc-link:focus-visible {
    color: var(--fg);
    background: color-mix(in srgb, var(--fg) 6%, transparent);
    outline: none;
  }

  .toc-link.active {
    color: var(--accent);
  }

  /* TOC — mobile */
  .toc-mobile {
    border-bottom: 1px solid var(--rule);
    padding: 0 var(--spacing-gutter);
  }

  @media (min-width: 1024px) {
    .toc-mobile {
      display: none;
    }
  }

  .toc-mobile-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .toc-mobile-summary::-webkit-details-marker {
    display: none;
  }

  .toc-mobile-summary svg {
    transition: transform 0.2s var(--ease-out-quart);
  }

  details[open] .toc-mobile-summary svg {
    transform: rotate(180deg);
  }

  .toc-mobile-list {
    list-style: none;
    padding: 0 0 1rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Main spec content */
  .spec-main {
    max-width: 72ch;
    width: 100%;
    min-width: 0;
    padding: 4rem var(--spacing-gutter) 6rem;
    margin: 0 auto;
    box-sizing: border-box;
  }

  @media (min-width: 1024px) {
    .spec-main {
      padding: 4rem 4rem 6rem;
      margin: 0;
    }
  }

  /* Header */
  .spec-header {
    margin-bottom: 4rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .spec-eyebrow {
    margin: 0 0 1.5rem;
  }

  .version-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-hover);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
  }

  .spec-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 0 0 1rem;
  }

  .spec-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    font-size: var(--text-sm);
    color: var(--muted);
    margin-bottom: 1.5rem;
  }

  .meta-sep {
    color: var(--rule);
  }

  .spec-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .action-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-sm);
    color: var(--muted);
    text-decoration: none;
    border: 1px solid var(--rule);
    padding: 0.375rem 0.875rem;
    border-radius: 6px;
    transition: color 0.15s, border-color 0.15s;
  }

  .action-link:hover,
  .action-link:focus-visible {
    color: var(--fg);
    border-color: var(--muted);
    outline: none;
  }

  /* Spec body typography */
  .spec-body {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .spec-body section {
    scroll-margin-top: 1.5rem;
  }

  .spec-body p {
    margin: 0 0 1em;
    line-height: 1.7;
    max-width: 70ch;
  }

  .spec-body p:last-child {
    margin-bottom: 0;
  }

  .spec-body ul,
  .spec-body ol {
    padding-left: 1.5rem;
    margin: 0.75rem 0 1rem;
    line-height: 1.7;
    max-width: 70ch;
  }

  .spec-body li {
    margin-bottom: 0.4rem;
  }

  .spec-body code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: color-mix(in srgb, var(--fg) 7%, transparent);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }

  .spec-body pre {
    background: color-mix(in srgb, var(--fg) 5%, transparent);
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    margin: 0.75rem 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .spec-body pre code {
    background: none;
    padding: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  /* Section headings */
  .section-heading {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 1.25rem;
    scroll-margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .subsection-heading {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 1rem;
    scroll-margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .section-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    border: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
    flex-shrink: 0;
  }

  /* Copy button */
  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
    background: none;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 0.2rem 0.5rem;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s, color 0.15s, border-color 0.15s;
    margin-left: auto;
    flex-shrink: 0;
  }

  .section-heading:hover .copy-btn,
  .section-heading:focus-within .copy-btn,
  .subsection-heading:hover .copy-btn,
  .subsection-heading:focus-within .copy-btn {
    opacity: 1;
  }

  .copy-btn:hover,
  .copy-btn:focus-visible {
    color: var(--fg);
    border-color: var(--rule);
    outline: none;
    opacity: 1;
  }

  .copy-btn.copied {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
    opacity: 1;
  }

  /* Blockquotes */
  .spec-body blockquote {
    border-left: 3px solid var(--accent);
    margin: 1.25rem 0;
    padding: 0.75rem 0 0.75rem 1.25rem;
    color: var(--muted);
    font-style: normal;
    max-width: 70ch;
  }

  .spec-body blockquote em {
    color: var(--fg);
  }

  .spec-body blockquote strong {
    color: var(--fg);
    font-style: normal;
  }

  /* Numbered sections */
  .numbered-section {
    padding-left: 0;
  }

  /* Seven sections intro */
  .seven-sections-intro {
    border-top: 1px solid var(--rule);
    padding-top: 0.5rem;
    margin-top: 0.5rem;
  }

  /* Recommended note */
  .recommended-note {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    border: 1px solid var(--rule);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    margin: 0 0 0.75rem !important;
  }

  /* Table */
  .table-wrapper {
    overflow-x: auto;
    margin: 1rem 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  th {
    text-align: left;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    padding: 0.625rem 1rem;
    border-bottom: 1px solid var(--rule);
    font-weight: 400;
  }

  td {
    padding: 0.625rem 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--rule) 50%, transparent);
    vertical-align: top;
    line-height: 1.5;
  }

  tr:last-child td {
    border-bottom: none;
  }

  /* Changelog inline */
  .changelog-version-inline {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
    margin: 0 0 0.75rem;
    color: var(--fg);
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .changelog-date-inline {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--muted);
    font-weight: 400;
  }

  /* Links */
  .spec-link {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s;
  }

  .spec-link:hover,
  .spec-link:focus-visible {
    text-decoration-color: var(--fg);
    outline: none;
  }

  /* Footer */
  .spec-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
    font-size: var(--text-sm);
    color: var(--muted);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .spec-footer p {
    margin: 0;
  }

</style>


<script>
  // Smooth scroll
  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener("click", (e) => {
      const href = (e.currentTarget as HTMLAnchorElement).getAttribute("href");
      if (!href) return;
      const target = document.querySelector(href);
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: "smooth", block: "start" });
        history.pushState(null, "", href);
      }
    });
  });

  // Active TOC link via IntersectionObserver
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>(".toc-link");
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          tocLinks.forEach((link) => link.classList.remove("active"));
          document
            .querySelector<HTMLAnchorElement>(`.toc-link[href="#${entry.target.id}"]`)
            ?.classList.add("active");
        }
      });
    },
    { rootMargin: "0px 0px -80% 0px", threshold: 0 }
  );
  document.querySelectorAll("h2[id], h3[id]").forEach((h) => observer.observe(h));

  // Copy section button: markdown comes from the rendered SPEC file itself.
  const store = document.getElementById("spec-sections");
  const sectionMarkdown: Record<string, string> = JSON.parse(store?.textContent ?? "{}");
  const copyText = store?.dataset.copy ?? "Copy";
  const copiedText = store?.dataset.copied ?? "Copied";

  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = sectionMarkdown[btn.dataset.section ?? ""] ?? "";
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const label = btn.querySelector(".copy-label");
        btn.classList.add("copied");
        if (label) label.textContent = copiedText;
        setTimeout(() => {
          btn.classList.remove("copied");
          if (label) label.textContent = copyText;
        }, 2000);
      } catch {
        // Clipboard not available — silent fail
      }
    });
  });
</script>
