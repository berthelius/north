---
/**
 * The NORTH.md mark: a notched compass needle (1:2.6), drawn in the text
 * colour. It closes the wordmark the way the square closes BRTHLS, so it is
 * decorative wherever it appears and always aria-hidden. Size it by width;
 * the height follows the viewBox.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg class:list={["north-mark", className]} viewBox="0 0 10 26" aria-hidden="true" focusable="false">
  <path d="M5 0 10 26 5 21.5 0 26Z"></path>
</svg>

<style>
  .north-mark {
    display: block;
    flex-shrink: 0;
    aspect-ratio: 10 / 26;
    height: auto;
    fill: currentColor;
  }
</style>
