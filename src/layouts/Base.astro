---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
// Preload only latin subsets that gate LCP. Measured (Lighthouse mobile): on the
// landing the LCP element is the Anton h1, and preloading Inter as well delays it
// (LCP 1.8s vs 1.1s); on text pages the LCP element is an Inter paragraph.
import antonLatin from "@fontsource/anton/files/anton-latin-400-normal.woff2?url";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import { getAlternateLinks, normalizePath, type Language } from "../lib/i18n";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  lang?: Language;
  showHeader?: boolean;
  noindex?: boolean;
}

const {
  title = "NORTH.md — Give your AI agents judgment when the prompt runs out",
  description = "A single markdown file declaring purpose, ambition, and precomputed trade-offs to scale autonomous agency without drift.",
  ogImage = "/og/default.png",
  canonical,
  lang = "en",
  showHeader = true,
  noindex = false,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? "https://northfile.dev";
// One canonical form site-wide: apex host, no trailing slash (root stays "/").
const canonicalUrl = new URL(normalizePath(new URL(canonical ?? Astro.url.pathname, siteUrl).pathname), siteUrl).href;
const ogImageUrl = new URL(ogImage, siteUrl).href;

const isLanding = ["/", "/es"].includes(normalizePath(Astro.url.pathname));
const fontPreloads = isLanding ? [antonLatin] : [antonLatin, interLatin];

const alternateLinks = getAlternateLinks(Astro.url.pathname, siteUrl);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Fonts: latin subsets only; the rest load on demand via unicode-range -->
    {fontPreloads.map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}

    <!-- Language Alternates (Hreflang) -->
    {alternateLinks.map(({ lang: l, href }) => (
      <link rel="alternate" hreflang={l} href={href} />
    ))}

    <!-- Launch switch: kept noindex/nofollow until Commit B -->
    {noindex ? (
      <meta name="robots" content="noindex,nofollow" />
    ) : (
      <>
        <meta name="robots" content="noindex,nofollow,noarchive,nosnippet,noimageindex" />
        <meta name="googlebot" content="noindex,nofollow" />
      </>
    )}

    <!-- AIO / LLM Endpoints -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM index" />
    <link rel="alternate" type="text/markdown" href={lang === "es" ? "/es/spec.md" : "/spec.md"} title="Specification (markdown)" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="NORTH.md" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />

    <!-- View Transitions -->
    <meta name="view-transition" content="same-origin" />
  </head>
  <body>
    {showHeader && <Header lang={lang} currentPath={Astro.url.pathname} />}
    <slot />
  </body>
</html>
