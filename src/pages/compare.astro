---
import Base from "../layouts/Base.astro";

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? "https://northfile.dev";

const compareJsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "Comparing Agent Context Conventions — NORTH.md vs AGENTS.md, SOUL.md, VISION.md, and CONSTITUTION.md",
  "description": "An exhaustive architectural comparison of repository context files for AI coding agents. How NORTH.md provides decision arbitration alongside operational, constitutional, and identity files.",
  "author": {
    "@type": "Person",
    "name": "Viktor Berthelius",
    "url": "https://brthls.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "NORTH.md",
    "url": siteUrl
  },
  "datePublished": "2026-09-23",
  "url": `${siteUrl}/compare`,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `${siteUrl}/compare`
  }
};

const conventions = [
  {
    file: "README.md",
    question: "What is this project?",
    focus: "Human onboarding, high-level architecture, installation, public showcase.",
    consumer: "Humans (users, contributors, evaluators).",
    failureMode: "Nobody knows how to run or use the project.",
    boundaryWithNorth: "README explains what exists today for humans; NORTH declares how far to push tomorrow for agents.",
  },
  {
    file: "AGENTS.md / CLAUDE.md",
    question: "How do you work here?",
    focus: "Operational gates, build commands, lint rules, testing workflows, file ownership.",
    consumer: "AI coding agents (Claude Code, Cursor, Copilot, Codex).",
    failureMode: "Agents break the build, commit directly to main, violate repo workflow.",
    boundaryWithNorth: "AGENTS tells an agent how to run tests; NORTH tells it what quality standard counts as shippable.",
  },
  {
    file: "SOUL.md",
    question: "Who are you?",
    focus: "Project voice, tone, personality, values, communication aesthetics.",
    consumer: "Humans and AI agents drafting user-facing copy or conversational responses.",
    failureMode: "AI-generated text feels corporate, generic, or tonally dissonant.",
    boundaryWithNorth: "SOUL defines aesthetic voice; NORTH defines architectural ambition and trade-offs.",
  },
  {
    file: "design.md",
    question: "What visual contracts and UI tokens govern interfaces?",
    focus: "UI components, color tokens, layout hierarchy, responsive breakpoints, design systems.",
    consumer: "Frontend engineers, UI designers, autonomous UI agents (Google Antigravity, Claude Code).",
    failureMode: "Agents invent arbitrary CSS, break responsive layouts, or introduce visual inconsistency.",
    boundaryWithNorth: "design.md dictates the UI grammar and components; NORTH.md dictates whether UI polish is a 10x bet or a 1.1x commodity.",
  },
  {
    file: "VISION.md",
    question: "What future are we pursuing?",
    focus: "Five-year destination, market vision, aspirational horizon, long-term roadmap.",
    consumer: "Founders, product leaders, humans, high-level planning agents.",
    failureMode: "Inspirational poetry without operational consequences; fails to arbitrate sprint dilemmas.",
    boundaryWithNorth: "VISION is teleological (the destination); NORTH is algorithmic (the arbitration rules for today's PR).",
  },
  {
    file: "CONSTITUTION.md",
    question: "What lines must we never cross?",
    focus: "Non-negotiable negative constraints, compliance laws, privacy guardrails, security boundaries.",
    consumer: "Safety evaluators, guardrail systems, AI agents.",
    failureMode: "Paralysis by hyper-regulation without positive direction on what to build.",
    boundaryWithNorth: "CONSTITUTION enforces negative hard boundaries; NORTH defines positive optimization defaults.",
  },
  {
    file: "NORTH.md",
    question: "How do we choose when valid paths compete?",
    focus: "Purpose, ambition bar, asymmetric bets (10x vs 1.1x), anti-goals, precomputed trade-offs, reversibility.",
    consumer: "Humans and AI coding agents arbitrating non-trivial implementation decisions.",
    failureMode: "Agents default to safe mediocrity, incremental patches, and runaway WIP drift.",
    boundaryWithNorth: "The definitive arbitration layer: judgment when operational instructions run out.",
  },
];
---

<Base
  title="Comparing Agent Context Conventions — NORTH.md"
  description="How NORTH.md fits alongside AGENTS.md, SOUL.md, VISION.md, CONSTITUTION.md, and scoped rules in the modern agent stack."
  canonical={`${siteUrl}/compare`}
  ogImage="/og/compare.png"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(compareJsonLd)} />

  <main class="mx-auto max-w-4xl px-6 py-24 md:py-32">
    <!-- Back nav -->
    <nav class="mb-16">
      <a
        href="/"
        class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--muted)] underline decoration-dotted underline-offset-4 hover:text-[var(--fg)] transition-colors"
      >
        &larr; northfile.dev
      </a>
    </nav>

    <!-- Eyebrow -->
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--muted)]">
      architectural guide &middot; september 2026
    </p>

    <!-- Title -->
    <h1 class="mt-5 font-display text-4xl md:text-5xl leading-[1.05] tracking-tight">
      Comparing Agent Context Conventions
    </h1>

    <p class="mt-4 text-lg text-[var(--muted)] leading-relaxed max-w-2xl">
      The modern repository context stack has evolved rapidly. Today, autonomous agents encounter rules files, identity files, vision statements, and constitutional boundaries. Where does <strong class="text-[var(--fg)]">NORTH.md</strong> sit, and why does it exist?
    </p>

    <hr class="mt-10 border-[var(--rule)]" />

    <!-- Article body -->
    <article class="prose-compare mt-12 space-y-12">
      <!-- Section: The Skeptic's Challenge -->
      <section>
        <h2 class="font-display text-2xl md:text-3xl text-[var(--fg)]">
          The Skeptic's Question: "Why another Markdown file?"
        </h2>
        <p class="mt-4 text-[var(--muted)] leading-relaxed">
          Any disciplined engineer should greet a new repository file with suspicion. We already have <code>README.md</code>, <code>AGENTS.md</code>, <code>CLAUDE.md</code>, <code>SOUL.md</code>, and <code>.cursorrules</code>. Injecting another multi-page file burns context window tokens and risks diluting the model's attention.
        </p>
        <p class="mt-4 text-[var(--muted)] leading-relaxed">
          If <code>NORTH.md</code> were merely "another vision doc" or "a list of tips," it would deserve to be deleted. But agents in production face a failure mode that neither rules nor vision can prevent: <strong class="text-[var(--fg)]">the dilemma of competing valid paths</strong>.
        </p>
        <div class="mt-6 rounded-lg border border-[var(--rule)] bg-[var(--color-stone-100,#f5f5f4)] dark:bg-[var(--color-stone-900,#1c1917)] p-6">
          <p class="font-mono text-xs uppercase tracking-wider text-[var(--accent)] mb-2">The Production Dilemma</p>
          <p class="text-sm text-[var(--fg)] leading-relaxed italic">
            "When an agent receives an ambiguous refactor task, three distinct paths all pass CI, obey AGENTS.md, and respect CONSTITUTION.md:
            <br />1. The cowardly incremental patch that leaves root causes intact.
            <br />2. The megalomaniacal rewrite that opens 15 unrequested dependencies and explodes WIP.
            <br />3. The calibrated leap that compounds product advantage without over-engineering commodity code.
            <br /><br />
            Which one does the agent choose? Without NORTH.md, it almost always defaults to #1 or #2."
          </p>
        </div>
      </section>

      <!-- Section: Master Comparison Table -->
      <section>
        <h2 class="font-display text-2xl md:text-3xl text-[var(--fg)]">
          The Context Matrix
        </h2>
        <p class="mt-3 text-[var(--muted)] leading-relaxed">
          How each file answers a distinct, non-overlapping question in the development lifecycle:
        </p>

        <div
          class="mt-8 overflow-x-auto border border-[var(--rule)] rounded-lg focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--accent)]"
          tabindex="0"
          role="region"
          aria-label="Agent context comparison table"
        >
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-[var(--rule)] bg-[var(--color-stone-100,#f5f5f4)] dark:bg-[var(--color-stone-900,#1c1917)]">
                <th class="p-4 font-mono text-xs uppercase tracking-wider text-[var(--muted)]">File</th>
                <th class="p-4 font-mono text-xs uppercase tracking-wider text-[var(--muted)]">Core Question</th>
                <th class="p-4 font-mono text-xs uppercase tracking-wider text-[var(--muted)]">Consumer</th>
                <th class="p-4 font-mono text-xs uppercase tracking-wider text-[var(--muted)]">Boundary with NORTH.md</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--rule)]">
              {conventions.map((c) => (
                <tr class={c.file === "NORTH.md" ? "bg-[color-mix(in_srgb,var(--accent)_6%,transparent)]" : ""}>
                  <td class="p-4 font-mono font-medium text-[var(--fg)] whitespace-nowrap">
                    {c.file}
                  </td>
                  <td class="p-4 text-[var(--fg)] font-medium">
                    {c.question}
                  </td>
                  <td class="p-4 text-[var(--muted)] text-xs">
                    {c.consumer}
                  </td>
                  <td class="p-4 text-[var(--muted)] text-xs leading-relaxed">
                    {c.boundaryWithNorth}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section: Deep Dives -->
      <section class="space-y-8">
        <h2 class="font-display text-2xl md:text-3xl text-[var(--fg)]">
          Deep Dives: Resolving Common Ambiguities
        </h2>

        <!-- Deep Dive 1: VISION.md -->
        <div class="border-l-2 border-[var(--rule)] pl-6 py-2">
          <h3 class="font-display text-xl text-[var(--fg)]">
            1. NORTH.md vs. VISION.md
          </h3>
          <p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">
            <strong>VISION.md</strong> is teleological: it describes what the world looks like in 2030 if your company triumphs. It is written to inspire investors, recruits, and quarterly planning offsites. But an AI agent executing a PR on a Tuesday afternoon cannot derive whether to build or buy a webhook queue from an aspirational mission statement.
          </p>
          <p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">
            <strong>NORTH.md</strong> is operational arbitration: it declares concrete asymmetric bets (<em>"Go 10x on crypto invoice signing; accept 1.1x on settings UI"</em>), specific refusals (<em>"Anti-goal: We do not build CRM"</em>), and precomputed trade-off defaults (<em>"Safety over speed on fiscal code; speed over safety on internal admin"</em>).
          </p>
        </div>

        <!-- Deep Dive 2: CONSTITUTION.md -->
        <div class="border-l-2 border-[var(--rule)] pl-6 py-2">
          <h3 class="font-display text-xl text-[var(--fg)]">
            2. NORTH.md vs. CONSTITUTION.md
          </h3>
          <p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">
            <strong>CONSTITUTION.md</strong> enforces <em>negative hard boundaries</em>: never leak credentials, never drop a database without interactive confirmation, never bypass compliance policies. It is a set of invariant legal constraints.
          </p>
          <p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">
            <strong>NORTH.md</strong> provides <em>positive optimization vectors</em>. Knowing what you are forbidden from doing does not tell you what calibre of work you are expected to ship. NORTH tells the agent where to be ambitious and when to refuse commodity bloat.
          </p>
        </div>

        <!-- Deep Dive 3: AGENTS.md -->
        <div class="border-l-2 border-[var(--rule)] pl-6 py-2">
          <h3 class="font-display text-xl text-[var(--fg)]">
            3. NORTH.md vs. AGENTS.md / CLAUDE.md
          </h3>
          <p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">
            <strong>AGENTS.md</strong> governs the <em>mechanics of execution</em>: how to compile, which linter to run, which file boundaries belong to which subagent stream. It ensures the agent does not break the repository harness.
          </p>
          <p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">
            <strong>NORTH.md</strong> governs the <em>judgment of the increment</em>: is a feature truly "done" when the unit tests pass, or does "The Bar" demand an MCP server tool call, an n8n node, and zero-defect audit logs?
          </p>
        </div>

        <!-- Deep Dive 4: design.md -->
        <div class="border-l-2 border-[var(--rule)] pl-6 py-2">
          <h3 class="font-display text-xl text-[var(--fg)]">
            4. NORTH.md vs. design.md (Google)
          </h3>
          <p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">
            <strong>design.md</strong> governs the <em>visual system contract</em>: design tokens, typography scales, responsive breakpoints, and UI component standards (such as Google Material or Antigravity design conventions).
          </p>
          <p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">
            <strong>NORTH.md</strong> governs the <em>strategic priority of visual craft</em>: it tells the agent whether pixel-perfect micro-animations are an asymmetric 10x bet (e.g. for landing experiences) or an over-engineered distraction (e.g. for internal admin CRUD tables).
          </p>
        </div>
      </section>

      <!-- Section: The Composition Model -->
      <section class="border-t border-[var(--rule)] pt-10">
        <h2 class="font-display text-2xl md:text-3xl text-[var(--fg)]">
          The 5-Layer Composition Principle
        </h2>
        <p class="mt-4 text-[var(--muted)] leading-relaxed">
          The future of AI-native software engineering is not a single 500-line monolithic prompt file. It is <strong class="text-[var(--fg)]">modular 5-layer context composition</strong>:
        </p>

        <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
          <div class="rounded-lg border border-[var(--rule)] p-4 flex flex-col justify-between">
            <div>
              <p class="font-mono text-xs uppercase tracking-wider text-[var(--muted)]">Layer 1: Limits</p>
              <h3 class="mt-1 font-mono text-base font-semibold text-[var(--fg)]">CONSTITUTION.md</h3>
              <p class="mt-2 text-xs text-[var(--muted)] leading-normal">
                Non-negotiable negative boundaries, privacy, and safety invariants.
              </p>
            </div>
            <p class="mt-3 text-[0.65rem] font-mono text-[var(--muted)]">Anthropic</p>
          </div>

          <div class="rounded-lg border border-[var(--rule)] p-4 flex flex-col justify-between">
            <div>
              <p class="font-mono text-xs uppercase tracking-wider text-[var(--muted)]">Layer 2: Execution</p>
              <h3 class="mt-1 font-mono text-base font-semibold text-[var(--fg)]">AGENTS.md</h3>
              <p class="mt-2 text-xs text-[var(--muted)] leading-normal">
                Build commands, linters, testing workflows, and harness rules.
              </p>
            </div>
            <p class="mt-3 text-[0.65rem] font-mono text-[var(--muted)]">Linux Foundation</p>
          </div>

          <div class="rounded-lg border border-[var(--rule)] p-4 flex flex-col justify-between">
            <div>
              <p class="font-mono text-xs uppercase tracking-wider text-[var(--muted)]">Layer 3: Visual</p>
              <h3 class="mt-1 font-mono text-base font-semibold text-[var(--fg)]">design.md</h3>
              <p class="mt-2 text-xs text-[var(--muted)] leading-normal">
                UI tokens, responsive breakpoints, layout grids, and design contracts.
              </p>
            </div>
            <p class="mt-3 text-[0.65rem] font-mono text-[var(--muted)]">Google Material</p>
          </div>

          <div class="rounded-lg border border-[var(--rule)] p-4 flex flex-col justify-between">
            <div>
              <p class="font-mono text-xs uppercase tracking-wider text-[var(--muted)]">Layer 4: Voice</p>
              <h3 class="mt-1 font-mono text-base font-semibold text-[var(--fg)]">SOUL.md</h3>
              <p class="mt-2 text-xs text-[var(--muted)] leading-normal">
                Project character, persona, communication tone, and empathy.
              </p>
            </div>
            <p class="mt-3 text-[0.65rem] font-mono text-[var(--muted)]">Community</p>
          </div>

          <div class="rounded-lg border-2 border-[var(--accent)] bg-[color-mix(in_srgb,var(--accent)_5%,transparent)] p-4 flex flex-col justify-between">
            <div>
              <p class="font-mono text-xs uppercase tracking-wider text-[var(--accent)] font-semibold">Layer 5: Apex</p>
              <h3 class="mt-1 font-mono text-base font-bold text-[var(--fg)] flex items-center gap-1.5">
                NORTH.md
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
              </h3>
              <p class="mt-2 text-xs text-[var(--fg)] font-medium leading-normal">
                Purpose, quality bar, asymmetric bets, and precomputed trade-offs.
              </p>
            </div>
            <p class="mt-3 text-[0.65rem] font-mono text-[var(--accent)] font-semibold">BRTHLS</p>
          </div>
        </div>

        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="/spec"
            class="inline-flex items-center gap-2 rounded-full bg-[var(--fg)] px-5 py-2.5 text-sm font-medium text-[var(--bg)] transition hover:opacity-85"
          >
            Read the v0.1 Spec &rarr;
          </a>
          <a
            href="/why"
            class="inline-flex items-center gap-2 rounded-full border border-[var(--rule)] px-5 py-2.5 text-sm font-medium text-[var(--fg)] transition hover:bg-[var(--rule)]"
          >
            Why NORTH Matters
          </a>
        </div>
      </section>
    </article>

    <!-- Footer -->
    <footer class="mt-20 border-t border-[var(--rule)] pt-10 text-sm text-[var(--muted)]">
      <p>
        <a href="/" class="underline decoration-dotted underline-offset-4 hover:text-[var(--fg)]">&larr; Back to northfile.dev</a>
      </p>
      <p class="mt-3">
        MIT &copy; <a href="https://brthls.com" class="underline decoration-dotted underline-offset-4 hover:text-[var(--fg)]">Viktor Berthelius</a> &middot;
        <a href="https://github.com/berthelius/north" class="underline decoration-dotted underline-offset-4 hover:text-[var(--fg)]">GitHub</a>
      </p>
    </footer>
  </main>
</Base>
