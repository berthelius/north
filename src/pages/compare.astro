---
import Base from "../layouts/Base.astro";

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? "https://northfile.dev";

const compareJsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "Where NORTH.md fits: AGENTS.md, CLAUDE.md, SOUL.md, DESIGN.md, CONSTITUTION.md and VISION.md compared",
  "description": "What AGENTS.md, CLAUDE.md, SOUL.md, DESIGN.md, CONSTITUTION.md and VISION.md each answer, and where NORTH.md fits: a fair, file-by-file comparison.",
  "author": {
    "@type": "Person",
    "@id": "https://www.brthls.com/about#person",
    "name": "Viktor Berthelius",
    "url": "https://www.brthls.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "NORTH.md",
    "url": siteUrl
  },
  "datePublished": "2026-10-11",
  "url": `${siteUrl}/compare`,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `${siteUrl}/compare`
  }
};

const conventions = [
  {
    file: "README.md",
    question: "What is this project?",
    consumer: "People: users, contributors, evaluators.",
    boundaryWithNorth: "README describes what exists today; NORTH.md declares where it is going and how far to push.",
  },
  {
    file: "AGENTS.md / CLAUDE.md",
    question: "How do we work here?",
    consumer: "Coding agents. AGENTS.md is read by many tools (see agents.md); CLAUDE.md by Claude Code.",
    boundaryWithNorth: "AGENTS.md tells an agent how to run the tests; NORTH.md tells it what quality counts as shipped.",
  },
  {
    file: "SOUL.md",
    question: "Who is the agent?",
    consumer: "The agent itself: its persona, values, and tone.",
    boundaryWithNorth: "SOUL.md shapes how the agent speaks and behaves; NORTH.md shapes what the project optimises for.",
  },
  {
    file: "DESIGN.md",
    question: "What should the interface look like, and why?",
    consumer: "Coding agents that generate UI.",
    boundaryWithNorth: "DESIGN.md defines the tokens; NORTH.md says whether visual polish is a 10x bet or a 1.1x surface.",
  },
  {
    file: "VISION.md",
    question: "What future are we pursuing?",
    consumer: "Founders and planners. No formal convention exists.",
    boundaryWithNorth: "A vision describes the destination; NORTH.md adds the defaults that decide today's pull request.",
  },
  {
    file: "CONSTITUTION.md",
    question: "Which principles and boundaries are non-negotiable?",
    consumer: "Coding agents and the people who review their work.",
    boundaryWithNorth: "A constitution sets the limits; NORTH.md sets direction, ambition and trade-off defaults inside them.",
  },
  {
    file: "NORTH.md",
    question: "Where are we going, and how far do we push?",
    consumer: "People and coding agents making non-trivial decisions.",
    boundaryWithNorth: "The proposed direction layer: judgment for when every rule is satisfied and more than one path is still valid.",
  },
];

const layers = [
  { label: "Layer 1: Limits", file: "CONSTITUTION.md", desc: "Non-negotiable principles and boundaries.", origin: "Community · agentconstitution.dev" },
  { label: "Layer 2: Execution", file: "AGENTS.md", desc: "How to build, test and work in the repository.", origin: "agents.md · Linux Foundation" },
  { label: "Layer 3: Look", file: "DESIGN.md", desc: "Design tokens and the rationale behind them.", origin: "Google Labs" },
  { label: "Layer 4: Persona", file: "SOUL.md", desc: "The agent's persona, values and tone.", origin: "soul.md" },
];
---

<Base
  title="NORTH.md vs AGENTS.md, SOUL.md, DESIGN.md and more"
  description="What AGENTS.md, CLAUDE.md, SOUL.md, DESIGN.md, CONSTITUTION.md and VISION.md each answer, and where NORTH.md fits: a fair, file-by-file comparison."
  canonical={`${siteUrl}/compare`}
  ogImage="/og/compare.png"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(compareJsonLd)} />

  <main class="mx-auto max-w-4xl px-6 py-24 md:py-32">
    <!-- Back nav -->
    <nav class="mb-16">
      <a
        href="/"
        class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--muted)] underline decoration-dotted underline-offset-4 hover:text-[var(--fg)] transition-colors"
      >
        &larr; northfile.dev
      </a>
    </nav>

    <!-- Eyebrow -->
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--muted)]">
      guide &middot; october 2026
    </p>

    <!-- Title -->
    <h1 class="mt-5 font-display text-4xl md:text-5xl leading-[1.05] tracking-tight">
      Where NORTH.md fits
    </h1>

    <p class="mt-4 text-lg text-[var(--muted)] leading-relaxed max-w-2xl">
      Coding agents now read several kinds of repository file: rules, personas, design tokens, constitutions, vision statements. Each answers a different question. Here is what each one covers, where <strong class="text-[var(--fg)]">NORTH.md</strong> sits, and why it exists at all.
    </p>

    <hr class="mt-10 border-[var(--rule)]" />

    <!-- Article body -->
    <article class="prose-compare mt-12 space-y-12">
      <!-- Section: The Skeptic's Challenge -->
      <section>
        <h2 class="font-display text-2xl md:text-3xl text-[var(--fg)]">
          The fair objection: why another markdown file?
        </h2>
        <p class="mt-4 text-[var(--muted)] leading-relaxed">
          Any disciplined engineer should meet a new repository file with suspicion. You already have <code>README.md</code>, <code>AGENTS.md</code>, <code>CLAUDE.md</code>, <code>SOUL.md</code>, <code>DESIGN.md</code> and your editor's rules files. Every extra file costs context tokens and competes for the model's attention.
        </p>
        <p class="mt-4 text-[var(--muted)] leading-relaxed">
          If <code>NORTH.md</code> were just another vision doc or a list of tips, it would deserve deletion. It exists for one situation that neither rules nor vision statements address: <strong class="text-[var(--fg)]">choosing between valid paths that compete</strong>.
        </p>
        <div class="mt-6 rounded-lg border border-[var(--rule)] bg-[var(--color-stone-100,#f5f5f4)] dark:bg-[var(--color-stone-900,#1c1917)] p-6">
          <p class="font-mono text-xs uppercase tracking-wider text-[var(--accent)] mb-2">The Dilemma</p>
          <p class="text-sm text-[var(--fg)] leading-relaxed italic">
            An agent receives an ambiguous refactoring task. Three paths all pass CI, obey AGENTS.md and respect CONSTITUTION.md:
            <br />1. The timid patch that leaves the root cause in place.
            <br />2. The sprawling rewrite that adds dependencies and work nobody asked for.
            <br />3. The calibrated move that removes the failure mode without over-engineering commodity code.
            <br /><br />
            Which does the agent choose? Our hypothesis: with nothing stating the project's direction, it drifts to 1 or 2. NORTH.md is designed to make 3 the obvious choice.
          </p>
        </div>
      </section>

      <!-- Section: Master Comparison Table -->
      <section>
        <h2 class="font-display text-2xl md:text-3xl text-[var(--fg)]">
          Who answers what
        </h2>
        <p class="mt-3 text-[var(--muted)] leading-relaxed">
          Each file answers a different question:
        </p>

        <div
          class="mt-8 overflow-x-auto border border-[var(--rule)] rounded-lg focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--accent)]"
          tabindex="0"
          role="region"
          aria-label="Agent context comparison table"
        >
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-[var(--rule)] bg-[var(--color-stone-100,#f5f5f4)] dark:bg-[var(--color-stone-900,#1c1917)]">
                <th class="p-4 font-mono text-xs uppercase tracking-wider text-[var(--muted)]">File</th>
                <th class="p-4 font-mono text-xs uppercase tracking-wider text-[var(--muted)]">Core question</th>
                <th class="p-4 font-mono text-xs uppercase tracking-wider text-[var(--muted)]">Read by</th>
                <th class="p-4 font-mono text-xs uppercase tracking-wider text-[var(--muted)]">Boundary with NORTH.md</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--rule)]">
              {conventions.map((c) => (
                <tr class={c.file === "NORTH.md" ? "bg-[color-mix(in_srgb,var(--accent)_6%,transparent)]" : ""}>
                  <td class="p-4 font-mono font-medium text-[var(--fg)] whitespace-nowrap">
                    {c.file}
                  </td>
                  <td class="p-4 text-[var(--fg)] font-medium">
                    {c.question}
                  </td>
                  <td class="p-4 text-[var(--muted)] text-xs">
                    {c.consumer}
                  </td>
                  <td class="p-4 text-[var(--muted)] text-xs leading-relaxed">
                    {c.boundaryWithNorth}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section: Deep Dives -->
      <section class="space-y-8">
        <h2 class="font-display text-2xl md:text-3xl text-[var(--fg)]">
          Where the lines blur
        </h2>

        <!-- Deep Dive 1: VISION.md -->
        <div class="border-l-2 border-[var(--rule)] pl-6 py-2">
          <h3 class="font-display text-xl text-[var(--fg)]">
            1. NORTH.md vs. VISION.md
          </h3>
          <p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">
            <strong>VISION.md</strong> has no formal convention. Where it exists, it usually describes the world the project hopes to create, and it is written to inspire. An agent working on a pull request on a Tuesday afternoon cannot derive from it whether to build or buy a webhook queue.
          </p>
          <p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">
            <strong>NORTH.md</strong> is operational. It declares concrete asymmetric bets (<em>&ldquo;Go 10x on e-invoicing correctness; accept 1.1x on the settings UI&rdquo;</em>), specific refusals (<em>&ldquo;We do not build a CRM&rdquo;</em>) and precomputed trade-off defaults (<em>&ldquo;Safety over speed on fiscal code; speed over safety on internal admin&rdquo;</em>).
          </p>
        </div>

        <!-- Deep Dive 2: CONSTITUTION.md -->
        <div class="border-l-2 border-[var(--rule)] pl-6 py-2">
          <h3 class="font-display text-xl text-[var(--fg)]">
            2. NORTH.md vs. CONSTITUTION.md
          </h3>
          <p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">
            <strong>CONSTITUTION.md</strong> sets <em>non-negotiable principles and boundaries</em>. There is no single standard: <a href="https://agentconstitution.dev" class="underline decoration-dotted underline-offset-4 hover:text-[var(--fg)]">agentconstitution.dev</a> proposes a project-level format, and GitHub Spec Kit keeps a project constitution of principles and governance. Some formats also record &ldquo;tension pairs&rdquo; (X over Y).
          </p>
          <p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">
            <strong>NORTH.md</strong> sets <em>direction</em>. Knowing what you must never do does not tell you what calibre of work is expected, or where to be ambitious and where to stop. If your constitution already records trade-offs, link to it from NORTH.md instead of repeating them.
          </p>
        </div>

        <!-- Deep Dive 3: AGENTS.md -->
        <div class="border-l-2 border-[var(--rule)] pl-6 py-2">
          <h3 class="font-display text-xl text-[var(--fg)]">
            3. NORTH.md vs. AGENTS.md / CLAUDE.md
          </h3>
          <p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">
            <strong>AGENTS.md</strong> covers the <em>mechanics of execution</em>: how to build, which linter to run, which conventions to follow. It keeps the agent from breaking the repository.
          </p>
          <p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">
            <strong>NORTH.md</strong> covers the <em>judgment of the increment</em>: is a feature done when the unit tests pass, or does The Bar also demand documentation, a public API and an audit trail?
          </p>
        </div>

        <!-- Deep Dive 4: DESIGN.md -->
        <div class="border-l-2 border-[var(--rule)] pl-6 py-2">
          <h3 class="font-display text-xl text-[var(--fg)]">
            4. NORTH.md vs. DESIGN.md
          </h3>
          <p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">
            <strong>DESIGN.md</strong> is a format from <a href="https://github.com/google-labs-code/design.md" class="underline decoration-dotted underline-offset-4 hover:text-[var(--fg)]">Google Labs</a> for describing a visual identity to coding agents: machine-readable design tokens in YAML front matter, with the rationale in markdown. It is in alpha.
          </p>
          <p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">
            <strong>NORTH.md</strong> sets the <em>priority of visual craft</em>: whether pixel-perfect micro-animations are a 10x bet (a landing page, say) or an over-engineered distraction (an internal admin table).
          </p>
        </div>
      </section>

      <!-- Section: The Composition Model -->
      <section class="border-t border-[var(--rule)] pt-10">
        <h2 class="font-display text-2xl md:text-3xl text-[var(--fg)]">
          A proposed five-layer model
        </h2>
        <p class="mt-4 text-[var(--muted)] leading-relaxed">
          Instead of one long instruction file, we propose <strong class="text-[var(--fg)]">five small files, each answering one question</strong>. It is a model, not an established standard, and most repositories will use only some of the layers.
        </p>

        <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
          {layers.map((l) => (
            <div class="rounded-lg border border-[var(--rule)] p-4 flex flex-col justify-between">
              <div>
                <p class="font-mono text-xs uppercase tracking-wider text-[var(--muted)]">{l.label}</p>
                <h3 class="mt-1 font-mono text-base font-semibold text-[var(--fg)]">{l.file}</h3>
                <p class="mt-2 text-xs text-[var(--muted)] leading-normal">{l.desc}</p>
              </div>
              <p class="mt-3 text-[0.65rem] font-mono text-[var(--muted)]">{l.origin}</p>
            </div>
          ))}

          <div class="rounded-lg border-2 border-[var(--accent)] bg-[color-mix(in_srgb,var(--accent)_5%,transparent)] p-4 flex flex-col justify-between">
            <div>
              <p class="font-mono text-xs uppercase tracking-wider text-[var(--accent)] font-semibold">Layer 5: Direction</p>
              <h3 class="mt-1 font-mono text-base font-bold text-[var(--fg)] flex items-center gap-1.5">
                NORTH.md
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
              </h3>
              <p class="mt-2 text-xs text-[var(--fg)] font-medium leading-normal">
                Purpose, ambition and precomputed trade-offs.
              </p>
            </div>
            <p class="mt-3 text-[0.65rem] font-mono text-[var(--accent)] font-semibold">This spec · MIT</p>
          </div>
        </div>

        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="/spec"
            class="inline-flex items-center gap-2 rounded-full bg-[var(--fg)] px-5 py-2.5 text-sm font-medium text-[var(--bg)] transition hover:opacity-85"
          >
            Read the spec v0.1 &rarr;
          </a>
          <a
            href="/why"
            class="inline-flex items-center gap-2 rounded-full border border-[var(--rule)] px-5 py-2.5 text-sm font-medium text-[var(--fg)] transition hover:bg-[var(--rule)]"
          >
            Why NORTH.md
          </a>
        </div>
      </section>
    </article>

    <!-- Footer -->
    <footer class="mt-20 border-t border-[var(--rule)] pt-10 text-sm text-[var(--muted)]">
      <p>
        <a href="/" class="underline decoration-dotted underline-offset-4 hover:text-[var(--fg)]">&larr; Back to northfile.dev</a>
      </p>
      <p class="mt-3">
        MIT &copy; <a href="https://www.brthls.com" class="underline decoration-dotted underline-offset-4 hover:text-[var(--fg)]">Viktor Berthelius</a> &middot;
        <a href="https://github.com/berthelius/north" class="underline decoration-dotted underline-offset-4 hover:text-[var(--fg)]">GitHub</a>
      </p>
    </footer>
  </main>
</Base>
