---
import Base from "../layouts/Base.astro";

const entries = [
  {
    version: "v0.1",
    date: "2026-10-11",
    dateDisplay: "11 October 2026",
    status: "current",
    changes: [
      "First public release.",
      "Seven sections defined: North Star, The Bar, Asymmetric Bets, Anti-Goals, Trade-off Defaults, Ambition Triggers, and Reversibility.",
      "Trade-off Defaults name each default and the condition under which it flips.",
      "Proposed a five-layer model for agent context files (CONSTITUTION.md, AGENTS.md, DESIGN.md, SOUL.md, NORTH.md).",
      "Propagation guidance and an optional spec-version marker.",
      "Versioning policy adopted (semver).",
    ],
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "NORTH.md Specification Changelog",
  description:
    "Every change to the NORTH.md specification, version by version, and the semver policy that decides when an existing NORTH.md needs updating.",
  datePublished: "2026-10-11",
  author: {
    "@type": "Person",
    "@id": "https://www.brthls.com/about#person",
    name: "Viktor Berthelius",
    url: "https://www.brthls.com/about",
  },
  publisher: {
    "@type": "Organization",
    name: "BRTHLS",
    "@id": "https://www.brthls.com/#organization",
    url: "https://www.brthls.com",
  },
  url: "https://northfile.dev/changelog",
  mainEntityOfPage: "https://northfile.dev/changelog",
};
---

<Base
  title="NORTH.md changelog — Specification version history"
  description="Every change to the NORTH.md specification, version by version, and the semver policy that decides when an existing NORTH.md needs updating."
  canonical="https://northfile.dev/changelog"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="changelog-main" id="main-content">
    <!-- Hero -->
    <header class="changelog-header">
      <p class="changelog-eyebrow">Specification history</p>
      <h1 class="changelog-title">Changelog</h1>
      <p class="changelog-subtitle">
        Every change to the <a href="/spec" class="cl-link">NORTH.md specification</a>, newest first.
        Versions follow <a href="https://semver.org" class="cl-link">Semantic Versioning</a>.
      </p>
      <div class="changelog-actions">
        <a href="/spec.md" class="action-link" download>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 2v9M4 8l4 4 4-4M3 14h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Download spec.md
        </a>
        <a href="https://github.com/berthelius/north" class="action-link">
          Follow on GitHub
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <!-- Entries -->
    <section class="changelog-entries" aria-label="Version history">
      {
        entries.map((entry) => (
          <article class="changelog-entry" aria-labelledby={`v${entry.version.replace(".", "-")}`}>
            <div class="entry-meta">
              <time
                class="entry-version"
                datetime={entry.date}
                id={`v${entry.version.replace(".", "-")}`}
              >
                {entry.version}
              </time>
              <span class="entry-date">{entry.dateDisplay}</span>
              {entry.status === "current" && (
                <span class="entry-badge" aria-label="Current version">Current</span>
              )}
            </div>
            <div class="entry-body">
              <ul class="entry-changes" role="list">
                {entry.changes.map((change) => (
                  <li>{change}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </section>

    <!-- Semver guide -->
    <section class="semver-guide" aria-labelledby="semver-heading">
      <h2 id="semver-heading" class="semver-title">Versioning policy</h2>
      <dl class="semver-list">
        <div class="semver-item">
          <dt><code>MAJOR</code></dt>
          <dd>Breaking changes to the sections. Existing files may need to change, and the release says how.</dd>
        </div>
        <div class="semver-item">
          <dt><code>MINOR</code></dt>
          <dd>New sections, or clarifications that may change how a file is validated.</dd>
        </div>
        <div class="semver-item">
          <dt><code>PATCH</code></dt>
          <dd>Editorial changes. Existing files need nothing.</dd>
        </div>
      </dl>
      <p class="semver-note">
        Optional: declare the spec version your <code>NORTH.md</code> targets with
        <code>&lt;!-- NORTH.md spec: v0.1 --&gt;</code> on its first line.
      </p>
    </section>

    <!-- Footer -->
    <footer class="changelog-footer">
      <p>
        <a href="/spec" class="cl-link">Read the specification</a>
        <span class="meta-sep" aria-hidden="true">·</span>
        MIT &copy; <a href="https://www.brthls.com" class="cl-link">Viktor Berthelius</a>
        <span class="meta-sep" aria-hidden="true">·</span>
        <a href="https://github.com/berthelius/north" class="cl-link">GitHub</a>
      </p>
    </footer>
  </main>
</Base>

<style>
  .changelog-main {
    max-width: 72ch;
    margin: 0 auto;
    padding: 4rem var(--spacing-gutter) 6rem;
  }

  /* Header */
  .changelog-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .changelog-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--muted);
    margin: 0 0 1rem;
  }

  .changelog-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 0 0 1rem;
  }

  .changelog-subtitle {
    font-size: var(--text-base);
    color: var(--muted);
    line-height: 1.6;
    max-width: 56ch;
    margin: 0 0 1.5rem;
  }

  .changelog-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .action-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-sm);
    color: var(--muted);
    text-decoration: none;
    border: 1px solid var(--rule);
    padding: 0.375rem 0.875rem;
    border-radius: 6px;
    transition: color 0.15s, border-color 0.15s;
  }

  .action-link:hover,
  .action-link:focus-visible {
    color: var(--fg);
    border-color: var(--muted);
    outline: none;
  }

  /* Entries */
  .changelog-entries {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 3.5rem;
  }

  .changelog-entry {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .changelog-entry:first-child {
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 640px) {
    .changelog-entry {
      grid-template-columns: 160px 1fr;
      gap: 2rem;
    }
  }

  .entry-meta {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    flex-shrink: 0;
  }

  .entry-version {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 400;
    color: var(--fg);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .entry-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .entry-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-hover);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    width: fit-content;
  }

  .entry-body {
    padding-top: 0.25rem;
  }

  .entry-changes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .entry-changes li {
    display: flex;
    gap: 0.75rem;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--fg);
  }

  .entry-changes li::before {
    content: "—";
    color: var(--muted);
    flex-shrink: 0;
    margin-top: 0.05em;
  }

  /* Semver guide */
  .semver-guide {
    padding: 2rem;
    background: color-mix(in srgb, var(--fg) 3%, transparent);
    border: 1px solid var(--rule);
    border-radius: 10px;
    margin-bottom: 3rem;
  }

  .semver-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 400;
    letter-spacing: -0.01em;
    margin: 0 0 1.25rem;
    line-height: 1.1;
  }

  .semver-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0 0 1.25rem;
  }

  .semver-item {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1rem;
    align-items: baseline;
  }

  @media (max-width: 480px) {
    .semver-item {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }

  .semver-item dt {
    font-size: var(--text-sm);
  }

  .semver-item dd {
    font-size: var(--text-sm);
    color: var(--muted);
    margin: 0;
    line-height: 1.5;
  }

  .semver-note {
    font-size: var(--text-sm);
    color: var(--muted);
    line-height: 1.5;
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: color-mix(in srgb, var(--fg) 7%, transparent);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }

  /* Links */
  .cl-link {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s;
  }

  .cl-link:hover,
  .cl-link:focus-visible {
    text-decoration-color: var(--fg);
    outline: none;
  }

  /* Footer */
  .changelog-footer {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .changelog-footer p {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    align-items: center;
  }

  .meta-sep {
    color: var(--rule);
  }
</style>
