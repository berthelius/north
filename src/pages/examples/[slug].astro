---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import Arrow from "../../components/ui/Arrow.astro";

export async function getStaticPaths() {
  const examples = await getCollection("examples");
  return examples.map((example) => ({
    params: { slug: example.id },
    props: { example },
  }));
}

const { example } = Astro.props;
const { Content } = await render(example);
// Raw body for copy-to-clipboard (excludes frontmatter, includes spec comment)
const rawBody = example.body ?? "";

const domainLabels: Record<string, string> = {
  "open-convention": "Open convention",
  "saas-b2b": "SaaS B2B",
  "oss-library": "OSS Library",
  "agency": "Agency",
  "side-project": "Side Project",
  "internal-tool": "Internal Tool",
};

const domainLabel = domainLabels[example.data.domain] ?? example.data.domain;
const isReal = example.data.kind === "real";
const kindNote = isReal
  ? "Real file. The NORTH.md at the root of the northfile.dev repository, reproduced verbatim."
  : "Illustrative example. A fictional organisation; its names, figures and domains are invented.";
const sourceUrl = isReal
  ? "https://github.com/berthelius/north/blob/main/NORTH.md"
  : `https://github.com/berthelius/north/blob/main/src/content/examples/${example.id}.md`;
---

<Base
  title={`${example.data.title} — NORTH.md Example`}
  description={isReal
    ? `${example.data.subtitle}. The real NORTH.md behind northfile.dev, reproduced verbatim.`
    : `${example.data.subtitle}. An illustrative NORTH.md example for the ${domainLabel} domain.`}
  ogImage="/og/examples.png"
>
  <main class="frame specimen">
    <!-- Breadcrumb -->
    <p class="label specimen__crumb">
      <span class="signal" aria-hidden="true"></span>
      <a href="/examples">examples</a>
      <span aria-hidden="true">/</span>
      <span class="specimen__here">{example.data.title}</span>
    </p>

    <div class="specimen__grid">
      <!-- The rail: what this file is, and how to take it -->
      <div class="specimen__rail">
        <div class="specimen__tags">
          <span class="tag tag--accent label">{domainLabel}</span>
          <span class="tag label">{isReal ? "Real" : "Illustrative"}</span>
        </div>

        <h1 class="specimen__title">{example.data.title}</h1>
        <p class="specimen__sub">{example.data.subtitle}</p>
        <p class="specimen__kind">{kindNote}</p>

        <aside class="specimen__note" aria-label={isReal ? "About this file" : "Why this NORTH.md works"}>
          <p class="label specimen__note-label">{isReal ? "About this file" : "Why this NORTH.md works"}</p>
          <p class="specimen__note-text">{example.data.whyItWorks}</p>
        </aside>

        <div class="specimen__copy">
          <button id="copy-btn" class="btn btn-primary" data-body={rawBody}>
            <span id="copy-label">Copy this file</span>
          </button>
          <span id="copy-feedback" class="specimen__feedback" aria-live="polite" aria-atomic="true">
            Copied to clipboard
          </span>
        </div>
      </div>

      <!-- Rendered NORTH.md body -->
      <article class="prose-north" aria-label={`${example.data.title} NORTH.md content`}>
        <Content />
      </article>
    </div>

    <!-- Footer actions -->
    <div class="specimen__actions">
      <a href="/examples" class="text-link">
        <Arrow dir="left" /> All examples
      </a>
      <a href={sourceUrl} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
        View source on GitHub
        <Arrow dir="up-right" class="btn-arrow" />
      </a>
    </div>

    <!-- Site footer -->
    <footer class="specimen__foot">
      <p>
        MIT ©{" "}
        <a href="https://brthls.com">Viktor Berthelius</a>
        {" "}·{" "}
        <a href="https://github.com/berthelius/north">GitHub</a>
        {" "}·{" "}
        <a href="/">northfile.dev</a>
      </p>
    </footer>
  </main>
</Base>

<style>
  .specimen {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3rem, 6vw, 5rem);
  }

  .specimen__crumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin: 0;
    padding-bottom: 1rem;
    color: var(--muted);
    border-bottom: 1px solid var(--fg);
  }

  .specimen__crumb a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-block: -0.75rem;
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .specimen__crumb a:hover {
    color: var(--accent);
  }

  .specimen__here {
    color: var(--fg);
  }

  .specimen__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 4rem) clamp(3rem, 6vw, 6rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .specimen__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    padding: 0.2rem 0.5rem;
    color: var(--muted);
    border: 1px solid var(--rule);
  }

  .tag--accent {
    color: var(--accent);
    border-color: currentColor;
  }

  .specimen__title {
    margin: 1.25rem 0 0;
    font-size: clamp(3rem, 10vw, 5.25rem);
    line-height: 0.92;
  }

  .specimen__sub {
    margin: 1rem 0 0;
    font-size: 1.125rem;
    line-height: 1.45;
    color: var(--fg);
  }

  .specimen__kind {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .specimen__note {
    margin-top: 2rem;
    padding: 0.1rem 0 0.1rem 1.25rem;
    border-left: 1px solid var(--accent);
  }

  .specimen__note-label {
    margin: 0 0 0.6rem;
    color: var(--accent);
  }

  .specimen__note-text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .specimen__copy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 2rem;
  }

  .specimen__copy .btn {
    cursor: pointer;
    font-family: inherit;
  }

  /* Hidden until a copy succeeds: becoming visible is what the live
     region announces. */
  .specimen__feedback {
    visibility: hidden;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .specimen__feedback.is-shown {
    visibility: visible;
  }

  .specimen__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--fg);
  }

  .specimen__foot {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .specimen__foot p {
    margin: 0;
  }

  .specimen__foot a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--fg);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .specimen__foot a:hover {
    color: var(--accent);
  }

  @media (min-width: 1024px) {
    .specimen__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
  }

  /* Pin the rail only when it fits on screen. */
  @media (min-width: 1024px) and (min-height: 760px) {
    .specimen__rail {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }
</style>

<style is:global>
  /* The rendered NORTH.md, set as a document under its own ink rule. */
  .prose-north {
    max-width: 46rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--fg);
  }

  .prose-north h1 {
    margin: 0 0 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--fg);
    font-size: clamp(2rem, 4vw, 2.75rem);
  }

  .prose-north h2 {
    margin: 2.75rem 0 0.9rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule);
    font-size: clamp(1.45rem, 2.6vw, 1.85rem);
  }

  .prose-north h3 {
    margin: 1.75rem 0 0.5rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: 0;
    line-height: 1.4;
    text-transform: none;
  }

  .prose-north p {
    margin: 0 0 1rem;
  }

  .prose-north ul,
  .prose-north ol {
    margin: 0.5rem 0 1.1rem;
    padding-left: 1.25rem;
  }

  .prose-north li {
    margin-bottom: 0.4rem;
    padding-left: 0.25rem;
  }

  .prose-north li::marker {
    color: var(--muted);
  }

  .prose-north strong {
    font-weight: 650;
  }

  .prose-north em {
    font-style: italic;
    color: var(--muted);
  }

  .prose-north code {
    padding: 0.1em 0.35em;
    font-size: 0.86em;
    background: var(--surface);
  }

  .prose-north pre {
    margin: 1.25rem 0;
    padding: 1.25rem 1.35rem;
    overflow-x: auto;
    background: var(--ink-bg);
    color: var(--ink-fg);
    border: 1px solid var(--ink-rule);
  }

  .prose-north pre code {
    padding: 0;
    font-size: 0.8125rem;
    line-height: 1.7;
    background: none;
  }

  .prose-north blockquote {
    margin: 1.25rem 0;
    padding-left: 1.25rem;
    border-left: 1px solid var(--accent);
    color: var(--muted);
  }

  .prose-north hr {
    margin: 2rem 0;
    border: 0;
    border-top: 1px solid var(--rule);
  }

  .prose-north table {
    display: block;
    width: 100%;
    margin: 1.25rem 0;
    overflow-x: auto;
    border-collapse: collapse;
    border-top: 1px solid var(--fg);
    font-size: 0.9rem;
  }

  .prose-north th {
    padding: 0.75rem 1rem 0.75rem 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.09em;
    text-align: left;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--muted);
    border-bottom: 1px solid var(--rule);
  }

  .prose-north td {
    padding: 0.75rem 1rem 0.75rem 0;
    vertical-align: top;
    line-height: 1.5;
    border-bottom: 1px solid var(--rule);
  }

  .prose-north a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  .prose-north a:hover {
    color: var(--accent);
  }
</style>

<script>
  const copyBtn = document.getElementById("copy-btn") as HTMLButtonElement | null;
  const copyLabel = document.getElementById("copy-label");
  const copyFeedback = document.getElementById("copy-feedback");

  copyBtn?.addEventListener("click", async () => {
    const body = copyBtn.dataset.body ?? "";
    const slug = window.location.pathname.replace(/^\/examples\//, "").replace(/\/$/, "");

    try {
      await navigator.clipboard.writeText(body);

      if (copyLabel) copyLabel.textContent = "Copied";
      copyFeedback?.classList.add("is-shown");
      setTimeout(() => {
        copyFeedback?.classList.remove("is-shown");
        if (copyLabel) copyLabel.textContent = "Copy this file";
      }, 2000);
    } catch {
      // Clipboard API not available: open the GitHub source as a fallback.
      window.open(`https://github.com/berthelius/north/blob/main/src/content/examples/${slug}.md`, "_blank");
    }
  });
</script>
