---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const examples = await getCollection("examples");
  return examples.map((example) => ({
    params: { slug: example.id },
    props: { example },
  }));
}

const { example } = Astro.props;
const { Content } = await render(example);
// Raw body for copy-to-clipboard (excludes frontmatter, includes spec comment)
const rawBody = example.body ?? "";

const domainLabels: Record<string, string> = {
  "open-convention": "Open convention",
  "saas-b2b": "SaaS B2B",
  "oss-library": "OSS Library",
  "agency": "Agency",
  "side-project": "Side Project",
  "internal-tool": "Internal Tool",
};

const domainLabel = domainLabels[example.data.domain] ?? example.data.domain;
const isReal = example.data.kind === "real";
const kindNote = isReal
  ? "Real file. The NORTH.md at the root of the northfile.dev repository, reproduced verbatim."
  : "Illustrative example. A composite of a fictional organisation; names, figures and domains are invented.";
const sourceUrl = isReal
  ? "https://github.com/berthelius/north/blob/main/NORTH.md"
  : `https://github.com/berthelius/north/blob/main/src/content/examples/${example.id}.md`;
---

<Base
  title={`${example.data.title} — NORTH.md Example`}
  description={isReal
    ? `${example.data.subtitle}. The real NORTH.md behind northfile.dev, reproduced verbatim.`
    : `${example.data.subtitle}. An illustrative NORTH.md example for the ${domainLabel} domain.`}
>
  <main class="mx-auto max-w-3xl px-6 py-24 md:py-32">
    <!-- Breadcrumb -->
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--muted)]">
      <a href="/examples" class="hover:text-[var(--fg)] transition-colors">examples</a>
      <span class="mx-2">/</span>
      <span class="text-[var(--fg)]">{example.data.title}</span>
    </p>

    <!-- Header -->
    <div class="mt-6">
      <div class="flex items-center gap-2 flex-wrap">
        <span
          class="inline-block font-mono text-[10px] uppercase tracking-[0.15em] px-2 py-0.5 rounded-sm border"
          style="color: var(--accent); border-color: currentColor;"
        >
          {domainLabel}
        </span>
        <span class="inline-block font-mono text-[10px] uppercase tracking-[0.15em] px-2 py-0.5 rounded-sm border border-[var(--rule)] text-[var(--muted)]">
          {isReal ? "Real" : "Illustrative"}
        </span>
      </div>

      <h1 class="mt-3 font-display text-4xl md:text-5xl leading-[1.0] tracking-tight">
        {example.data.title}
      </h1>
      <p class="mt-3 text-lg text-[var(--muted)] leading-snug">
        {example.data.subtitle}
      </p>
      <p class="mt-2 text-sm text-[var(--muted)]">
        {kindNote}
      </p>
    </div>

    <!-- Editor's note callout -->
    <aside
      class="mt-8 border-l-2 border-[var(--accent)] pl-5 py-1"
      aria-label={isReal ? "About this file" : "Why this NORTH.md works"}
    >
      <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-[var(--accent)] mb-2">
        {isReal ? "About this file" : "Why this NORTH.md works"}
      </p>
      <p class="text-sm italic text-[var(--muted)] leading-relaxed">
        {example.data.whyItWorks}
      </p>
    </aside>

    <!-- Copy button -->
    <div class="mt-8 flex items-center gap-3">
      <button
        id="copy-btn"
        class="inline-flex items-center gap-2 rounded-full border border-[var(--rule)] px-5 py-2.5 text-sm font-medium text-[var(--fg)] transition hover:bg-[var(--rule)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]"
        aria-label="Copy this NORTH.md template to clipboard"
        data-body={rawBody}
      >
        <span id="copy-label">Copy template</span>
      </button>
      <span
        id="copy-feedback"
        class="text-sm text-[var(--muted)] opacity-0 transition-opacity"
        aria-live="polite"
        aria-atomic="true"
      >
        Copied to clipboard
      </span>
    </div>

    <!-- Rendered NORTH.md body -->
    <article
      class="prose-north mt-12"
      aria-label={`${example.data.title} NORTH.md content`}
    >
      <Content />
    </article>

    <!-- Footer actions -->
    <div class="mt-16 border-t border-[var(--rule)] pt-8 flex flex-wrap gap-4 items-center justify-between">
      <a
        href="/examples"
        class="inline-flex items-center gap-2 text-sm text-[var(--muted)] hover:text-[var(--fg)] transition-colors"
      >
        <span aria-hidden>←</span> All examples
      </a>
      <a
        href={sourceUrl}
        class="inline-flex items-center gap-2 rounded-full border border-[var(--rule)] px-4 py-2 text-sm font-medium text-[var(--fg)] transition hover:bg-[var(--rule)]"
        target="_blank"
        rel="noopener noreferrer"
      >
        View source on GitHub
        <span aria-hidden>↗</span>
      </a>
    </div>

    <!-- Site footer -->
    <footer class="mt-16 border-t border-[var(--rule)] pt-8 text-sm text-[var(--muted)]">
      <p>
        MIT ©{" "}
        <a href="https://brthls.com" class="underline decoration-dotted underline-offset-4 hover:text-[var(--fg)]">Viktor Berthelius</a>
        {" "}·{" "}
        <a href="https://github.com/berthelius/north" class="underline decoration-dotted underline-offset-4 hover:text-[var(--fg)]">GitHub</a>
        {" "}·{" "}
        <a href="/" class="underline decoration-dotted underline-offset-4 hover:text-[var(--fg)]">northfile.dev</a>
      </p>
    </footer>
  </main>
</Base>

<style is:global>
  /* Prose styles for the rendered NORTH.md body */
  .prose-north {
    color: var(--fg);
    line-height: 1.6;
    max-width: none;
  }

  .prose-north h1 {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin-top: 0;
    margin-bottom: 1.25rem;
  }

  .prose-north h2 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.5rem;
  }

  .prose-north h3 {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .prose-north p {
    margin-top: 0;
    margin-bottom: 1rem;
    color: var(--fg);
  }

  .prose-north ul,
  .prose-north ol {
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  .prose-north li {
    margin-bottom: 0.375rem;
    color: var(--fg);
  }

  .prose-north li::marker {
    color: var(--muted);
  }

  .prose-north strong {
    font-weight: 600;
    color: var(--fg);
  }

  .prose-north em {
    font-style: italic;
    color: var(--muted);
  }

  .prose-north code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--color-stone-100);
    color: var(--fg);
    padding: 0.125rem 0.35rem;
    border-radius: 0.25rem;
  }

  @media (prefers-color-scheme: dark) {
    .prose-north code {
      background: var(--color-stone-800);
    }
  }

  .prose-north pre {
    background: var(--color-stone-100);
    border: 1px solid var(--rule);
    border-radius: 0.5rem;
    padding: 1.25rem;
    overflow-x: auto;
    margin: 1.25rem 0;
  }

  @media (prefers-color-scheme: dark) {
    .prose-north pre {
      background: var(--color-stone-900);
    }
  }

  .prose-north pre code {
    background: none;
    padding: 0;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .prose-north blockquote {
    border-left: 2px solid var(--rule);
    padding-left: 1.25rem;
    margin: 1.25rem 0;
    color: var(--muted);
    font-style: italic;
  }

  .prose-north hr {
    border: none;
    border-top: 1px solid var(--rule);
    margin: 2rem 0;
  }

  /* Tables */
  .prose-north table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    margin: 1.25rem 0;
    overflow-x: auto;
    display: block;
  }

  .prose-north thead {
    border-bottom: 1px solid var(--rule);
  }

  .prose-north th {
    text-align: left;
    padding: 0.5rem 0.75rem;
    font-weight: 600;
    font-size: 0.8125rem;
    color: var(--muted);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .prose-north td {
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
    line-height: 1.5;
  }

  .prose-north tr:last-child td {
    border-bottom: none;
  }

  /* HTML comment visibility suppression */
  .prose-north comment {
    display: none;
  }

  /* Links */
  .prose-north a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 3px;
  }

  .prose-north a:hover {
    color: var(--accent);
  }
</style>

<script>
  const copyBtn = document.getElementById("copy-btn") as HTMLButtonElement | null;
  const copyLabel = document.getElementById("copy-label");
  const copyFeedback = document.getElementById("copy-feedback") as HTMLElement | null;

  copyBtn?.addEventListener("click", async () => {
    const body = copyBtn.dataset.body ?? "";
    const slug = window.location.pathname.replace(/^\/examples\//, "").replace(/\/$/, "");

    try {
      await navigator.clipboard.writeText(body);

      if (copyLabel) copyLabel.textContent = "Copied";
      if (copyFeedback) {
        copyFeedback.style.opacity = "1";
        setTimeout(() => {
          if (copyFeedback) copyFeedback.style.opacity = "0";
          if (copyLabel) copyLabel.textContent = "Copy template";
        }, 2000);
      }
    } catch {
      // Clipboard API not available — open GitHub source as fallback
      window.open(
        `https://github.com/berthelius/north/blob/main/src/content/examples/${slug}.md`,
        "_blank"
      );
    }
  });
</script>
