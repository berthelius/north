---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import Arrow from "../../components/ui/Arrow.astro";

const allExamples = await getCollection("examples");
const examples = allExamples.sort((a, b) => a.data.order - b.data.order);

const domainLabels: Record<string, string> = {
  "open-convention": "Open convention",
  "saas-b2b": "SaaS B2B",
  "oss-library": "OSS Library",
  "agency": "Agency",
  "side-project": "Side Project",
  "internal-tool": "Internal Tool",
};

const domainKeys = Object.keys(domainLabels);
---

<Base
  title="Examples — NORTH.md across domains"
  description="NORTH.md examples: this site's own file, plus five illustrative files for a SaaS, an open-source library, a creative agency, a side project, and an internal platform."
  ogImage="/og/examples.png"
>
  <main class="frame examples">
    <header class="examples__head">
      <p class="label examples__crumb">
        <span class="signal" aria-hidden="true"></span>
        northfile.dev / examples
      </p>
      <h1 class="examples__title">Examples</h1>
      <p class="examples__intro">
        NORTH.md reads differently depending on the project type. The first
        example is real: the NORTH.md at the root of this site's repository. The other five
        are illustrative — composites of fictional organisations, with invented
        names, figures and domains — written as complete files you could adapt.
      </p>
    </header>

    <!-- Domain filter chips -->
    <div class="chips" id="filter-chips" role="group" aria-label="Filter examples by domain">
      <button class="filter-chip label" data-domain="all" data-active="true" aria-pressed="true">All</button>
      {domainKeys.map((d) => (
        <button class="filter-chip label" data-domain={d} data-active="false" aria-pressed="false">
          {domainLabels[d]}
        </button>
      ))}
    </div>

    <!-- Example list -->
    <ul class="example-list" id="example-list" role="list">
      {examples.map((example) => (
        <li class="example-card" data-domain={example.data.domain}>
          <a href={`/examples/${example.id}`} class="example-row">
            <span class="example-row__tags">
              <span class="tag tag--accent label">{domainLabels[example.data.domain]}</span>
              <span class="tag label">{example.data.kind === "real" ? "Real" : "Illustrative"}</span>
            </span>
            <h2 class="example-row__title">{example.data.title}</h2>
            <p class="example-row__sub">{example.data.subtitle}</p>
            <Arrow class="example-row__arrow" />
          </a>
        </li>
      ))}
    </ul>

    <!-- Submit CTA -->
    <section class="submit" aria-labelledby="submit-heading">
      <h2 id="submit-heading" class="submit__title">Submit your NORTH.md</h2>
      <div>
        <p class="submit__text">
          Have a NORTH.md that exemplifies the convention for your domain? Open a
          GitHub issue — we review and add examples that demonstrate a genuinely
          different pattern.
        </p>
        <a
          href="https://github.com/berthelius/north/issues/new"
          class="btn btn-secondary"
          target="_blank"
          rel="noopener noreferrer"
        >
          Open an issue
          <Arrow dir="up-right" class="btn-arrow" />
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="page-foot">
      <p>
        <a href="/">← Back to northfile.dev</a>
      </p>
      <p>
        MIT ©{" "}
        <a href="https://brthls.com">Viktor Berthelius</a>
        {" "}·{" "}
        <a href="https://github.com/berthelius/north">GitHub</a>
      </p>
    </footer>
  </main>
</Base>

<style>
  .examples {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(3rem, 6vw, 5rem);
  }

  .examples__head {
    display: grid;
    gap: 1.5rem clamp(2rem, 5vw, 5rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--fg);
  }

  .examples__crumb {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0;
    color: var(--muted);
  }

  .examples__title {
    margin: 0;
    font-size: clamp(3.5rem, 13vw, 9rem);
    line-height: 0.9;
  }

  .examples__intro {
    margin: 0;
    max-width: 36rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: clamp(1.75rem, 3vw, 2.5rem) 0;
  }

  .filter-chip {
    min-height: 2.75rem;
    padding: 0 0.95rem;
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--rule);
    cursor: pointer;
    transition:
      color 160ms,
      border-color 160ms,
      background-color 160ms;
  }

  .filter-chip:hover {
    color: var(--fg);
    border-color: var(--fg);
  }

  .filter-chip[data-active="true"] {
    color: var(--bg);
    background: var(--fg);
    border-color: var(--fg);
  }

  .example-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }

  .example-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "tags arrow"
      "title title"
      "sub sub";
    align-items: center;
    padding-block: 1.5rem 1.6rem;
    border-top: 1px solid var(--rule);
    color: var(--fg);
    text-decoration: none;
  }

  .example-row__tags {
    grid-area: tags;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    padding: 0.2rem 0.5rem;
    color: var(--muted);
    border: 1px solid var(--rule);
  }

  .tag--accent {
    color: var(--accent);
    border-color: currentColor;
  }

  .example-row__title {
    grid-area: title;
    margin: 0.9rem 0 0;
    font-size: clamp(1.9rem, 7vw, 3.25rem);
    line-height: 1;
    transition: color 160ms;
  }

  .example-row__sub {
    grid-area: sub;
    margin: 0.6rem 0 0;
    max-width: 34rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .example-row :global(.example-row__arrow) {
    grid-area: arrow;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--muted);
    transition:
      transform 260ms var(--ease-out-expo),
      color 160ms;
  }

  .example-row:hover .example-row__title,
  .example-row:hover :global(.example-row__arrow) {
    color: var(--accent);
  }

  .example-row:hover :global(.example-row__arrow) {
    transform: translateX(4px);
  }

  .example-row:focus-visible {
    outline-offset: -2px;
  }

  .submit {
    display: grid;
    gap: 1.25rem clamp(2rem, 5vw, 5rem);
    margin-top: clamp(3.5rem, 7vw, 6rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--fg);
  }

  .submit__title {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 2.75rem);
  }

  .submit__text {
    margin: 0 0 1.5rem;
    max-width: 34rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .page-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: clamp(3.5rem, 7vw, 6rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .page-foot p {
    margin: 0;
  }

  .page-foot a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--fg);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .page-foot a:hover {
    color: var(--accent);
  }

  @media (min-width: 960px) {
    .examples__head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
    }

    .examples__crumb {
      grid-column: 1 / -1;
    }

    .example-row {
      grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) minmax(0, 4fr) 3rem;
      grid-template-areas: "tags title sub arrow";
      align-items: baseline;
      column-gap: 2rem;
      padding-block: 1.75rem;
    }

    .example-row__title,
    .example-row__sub {
      margin: 0;
    }

    .example-row :global(.example-row__arrow) {
      justify-self: end;
      align-self: center;
    }

    .submit {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>(".filter-chip");
  const cards = document.querySelectorAll<HTMLElement>(".example-card");

  function setActive(domain: string) {
    chips.forEach((chip) => {
      const isActive = chip.dataset.domain === domain;
      chip.dataset.active = isActive ? "true" : "false";
      chip.setAttribute("aria-pressed", isActive ? "true" : "false");
    });

    cards.forEach((card) => {
      const matches = domain === "all" || card.dataset.domain === domain;
      card.style.display = matches ? "" : "none";
    });
  }

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      setActive(chip.dataset.domain ?? "all");
    });
  });
</script>
