  /* Essay typography */
  .essay {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.78;
    color: var(--fg);
  }

  .essay p {
    max-width: 68ch;
    margin-bottom: 1.5em;
  }

  /* Drop cap on first paragraph */
