    font-family: var(--font-display);
    float: left;
    font-size: 4.2em;
    line-height: 0.82;
    padding-right: 0.12em;
    padding-top: 0.06em;
    color: var(--accent);
    font-weight: 400;
  }

  /* Headings within essay */
  .essay h2 {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-top: 3rem;
    margin-bottom: 1.2rem;
    max-width: 58ch;
    color: var(--fg);
  }

  /* Inline links */
  .essay a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 4px;
    transition: color 0.15s ease;
  }

  .essay a:hover {
    color: var(--accent);
  }

  /* Code inline */
  .essay code {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--color-stone-100);
    border-radius: 3px;
    padding: 0.1em 0.35em;
    color: var(--fg);
  }

  @media (prefers-color-scheme: dark) {
    .essay code {
      background: var(--color-stone-800);
    }
  }

  /* Pull quotes */
  .pull-quote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.35rem;
    line-height: 1.45;
    color: var(--accent);
    border-left: 2px solid var(--accent);
    margin: 2.5rem 0;
    padding: 0.5rem 0 0.5rem 1.5rem;
    max-width: 58ch;
  }

  /* Section dividers */
  .section-rule {
    border: none;
    border-top: 1px solid var(--rule);
    margin: 3rem 0;
    max-width: 68ch;
  }

  /* Closing CTA block */
  .closing-cta {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
    max-width: 68ch;
  }

  /* Mobile — ensure 320px doesn't overflow */
  @media (max-width: 640px) {
    .essay {
      font-size: 1rem;
    }

    .pull-quote {
      font-size: 1.15rem;
      padding-left: 1rem;
      margin: 2rem 0;
    }

    .essay h2 {
      font-size: 1.35rem;
    }
  }
</style>
