---
import Base from "../../layouts/Base.astro";

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? "https://northfile.dev";

const compareJsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "Comparación de convenciones de contexto para agentes — NORTH.md frente a AGENTS.md, SOUL.md, DESIGN.md, VISION.md y CONSTITUTION.md",
  "description": "Una comparación de los archivos de contexto de un repositorio para agentes de IA de código, y de dónde encaja NORTH.md junto a los archivos operativos, de diseño, de persona y constitucionales.",
  "inLanguage": "es",
  "author": {
    "@type": "Person",
    "name": "Viktor Berthelius",
    "url": "https://brthls.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "NORTH.md",
    "url": siteUrl
  },
  "datePublished": "2026-10-11",
  "url": `${siteUrl}/es/compare`,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `${siteUrl}/es/compare`
  }
};

const conventions = [
  {
    file: "README.md",
    question: "¿Qué es este proyecto?",
    consumer: "Personas: usuarios, colaboradores, evaluadores.",
    boundaryWithNorth: "README explica lo que existe hoy; NORTH.md declara hasta dónde empujar a continuación.",
  },
  {
    file: "AGENTS.md / CLAUDE.md",
    question: "¿Cómo se trabaja aquí?",
    consumer: "Agentes de código. AGENTS.md lo leen muchas herramientas (ver agents.md); CLAUDE.md, Claude Code.",
    boundaryWithNorth: "AGENTS.md le dice a un agente cómo ejecutar los tests; NORTH.md le dice qué calidad cuenta como entregada.",
  },
  {
    file: "SOUL.md",
    question: "¿Quién es el agente?",
    consumer: "El propio agente: su persona, sus valores y su tono.",
    boundaryWithNorth: "SOUL.md define cómo habla y se comporta el agente; NORTH.md define qué optimiza el proyecto.",
  },
  {
    file: "DESIGN.md",
    question: "¿Cómo debe verse la interfaz, y por qué?",
    consumer: "Agentes de código que generan interfaz.",
    boundaryWithNorth: "DESIGN.md define los tokens; NORTH.md dice si el pulido visual es una apuesta 10x o una superficie 1.1x.",
  },
  {
    file: "VISION.md",
    question: "¿Qué futuro perseguimos?",
    consumer: "Fundadores y planificadores. No existe una convención formal.",
    boundaryWithNorth: "Una visión describe el destino; NORTH.md añade los valores por defecto que deciden la pull request de hoy.",
  },
  {
    file: "CONSTITUTION.md",
    question: "¿Qué principios y fronteras son innegociables?",
    consumer: "Agentes de código y las personas que los revisan.",
    boundaryWithNorth: "Una constitución fija límites y principios; NORTH.md fija la dirección, la ambición y los trade-offs por defecto dentro de ellos.",
  },
  {
    file: "NORTH.md",
    question: "¿Cómo elegimos cuando compiten varios caminos válidos?",
    consumer: "Personas y agentes de código que toman decisiones de implementación no triviales.",
    boundaryWithNorth: "La capa de dirección que proponemos: criterio cuando se agotan las instrucciones operativas.",
  },
];

const layers = [
  { label: "Capa 1: Límites", file: "CONSTITUTION.md", desc: "Principios innegociables y fronteras.", origin: "Comunidad · agentconstitution.dev" },
  { label: "Capa 2: Ejecución", file: "AGENTS.md", desc: "Comandos de build, tests, convenciones y flujo de trabajo.", origin: "agents.md · Linux Foundation" },
  { label: "Capa 3: Aspecto", file: "DESIGN.md", desc: "Tokens de diseño y la razón de cada uno.", origin: "Google Labs" },
  { label: "Capa 4: Persona", file: "SOUL.md", desc: "Quién es el agente: persona, valores y tono.", origin: "soul.md" },
];
---

<Base
  title="Comparación de convenciones de contexto para agentes — NORTH.md"
  description="Cómo encaja NORTH.md junto a AGENTS.md, CLAUDE.md, SOUL.md, DESIGN.md, VISION.md y CONSTITUTION.md."
  canonical={`${siteUrl}/es/compare`}
  ogImage="/og/compare.png"
  lang="es"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(compareJsonLd)} />

  <main class="mx-auto max-w-4xl px-6 py-24 md:py-32">
    <!-- Back nav -->
    <nav class="mb-16">
      <a
        href="/es"
        class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--muted)] underline decoration-dotted underline-offset-4 hover:text-[var(--fg)] transition-colors"
      >
        &larr; northfile.dev
      </a>
    </nav>

    <!-- Eyebrow -->
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--muted)]">
      guía &middot; octubre de 2026
    </p>

    <!-- Title -->
    <h1 class="mt-5 font-display text-4xl md:text-5xl leading-[1.05] tracking-tight">
      Comparación de convenciones de contexto para agentes
    </h1>

    <p class="mt-4 text-lg text-[var(--muted)] leading-relaxed max-w-2xl">
      Los agentes de código ya leen varios tipos de archivo en un repositorio: archivos de reglas, de persona, de diseño, declaraciones de visión y constituciones. ¿Dónde encaja <strong class="text-[var(--fg)]">NORTH.md</strong> y por qué existe?
    </p>

    <hr class="mt-10 border-[var(--rule)]" />

    <!-- Article body -->
    <article class="prose-compare mt-12 space-y-12">
      <!-- Section: The Skeptic's Challenge -->
      <section>
        <h2 class="font-display text-2xl md:text-3xl text-[var(--fg)]">
          La pregunta del escéptico: "¿Para qué otro archivo Markdown?"
        </h2>
        <p class="mt-4 text-[var(--muted)] leading-relaxed">
          Cualquier ingeniero riguroso recibe un archivo nuevo en el repositorio con recelo. Ya tenemos <code>README.md</code>, <code>AGENTS.md</code>, <code>CLAUDE.md</code>, <code>SOUL.md</code>, <code>DESIGN.md</code> y los archivos de reglas de cada editor. Otro archivo de varias páginas cuesta tokens de contexto y puede diluir la atención del modelo.
        </p>
        <p class="mt-4 text-[var(--muted)] leading-relaxed">
          Si <code>NORTH.md</code> fuese simplemente "otro documento de visión" o "una lista de consejos", merecería borrarse. Existe para una situación que ni las reglas ni las declaraciones de visión resuelven: <strong class="text-[var(--fg)]">elegir entre caminos válidos que compiten</strong>.
        </p>
        <div class="mt-6 rounded-lg border border-[var(--rule)] bg-[var(--color-stone-100,#f5f5f4)] dark:bg-[var(--color-stone-900,#1c1917)] p-6">
          <p class="font-mono text-xs uppercase tracking-wider text-[var(--accent)] mb-2">El dilema</p>
          <p class="text-sm text-[var(--fg)] leading-relaxed italic">
            Un agente recibe una tarea de refactorización ambigua. Tres caminos pasan el CI, obedecen AGENTS.md y respetan CONSTITUTION.md:
            <br />1. El parche incremental tímido que deja la causa raíz en su sitio.
            <br />2. La reescritura desmedida que añade dependencias y trabajo en curso que nadie pidió.
            <br />3. El salto calibrado que elimina el modo de fallo sin sobrediseñar código genérico.
            <br /><br />
            ¿Cuál elige el agente? Nuestra hipótesis: si nada declara la dirección del proyecto, deriva hacia el #1 o el #2. NORTH.md está pensado para que el #3 sea la opción evidente.
          </p>
        </div>
      </section>

      <!-- Section: Master Comparison Table -->
      <section>
        <h2 class="font-display text-2xl md:text-3xl text-[var(--fg)]">
          La matriz de contexto
        </h2>
        <p class="mt-3 text-[var(--muted)] leading-relaxed">
          Cada archivo responde a una pregunta distinta:
        </p>

        <div
          class="mt-8 overflow-x-auto border border-[var(--rule)] rounded-lg focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--accent)]"
          tabindex="0"
          role="region"
          aria-label="Tabla de comparación de contexto de agentes"
        >
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-[var(--rule)] bg-[var(--color-stone-100,#f5f5f4)] dark:bg-[var(--color-stone-900,#1c1917)]">
                <th class="p-4 font-mono text-xs uppercase tracking-wider text-[var(--muted)]">Archivo</th>
                <th class="p-4 font-mono text-xs uppercase tracking-wider text-[var(--muted)]">Pregunta central</th>
                <th class="p-4 font-mono text-xs uppercase tracking-wider text-[var(--muted)]">Consumidor</th>
                <th class="p-4 font-mono text-xs uppercase tracking-wider text-[var(--muted)]">Frontera con NORTH.md</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--rule)]">
              {conventions.map((c) => (
                <tr class={c.file === "NORTH.md" ? "bg-[color-mix(in_srgb,var(--accent)_6%,transparent)]" : ""}>
                  <td class="p-4 font-mono font-medium text-[var(--fg)] whitespace-nowrap">
                    {c.file}
                  </td>
                  <td class="p-4 text-[var(--fg)] font-medium">
                    {c.question}
                  </td>
                  <td class="p-4 text-[var(--muted)] text-xs">
                    {c.consumer}
                  </td>
                  <td class="p-4 text-[var(--muted)] text-xs leading-relaxed">
                    {c.boundaryWithNorth}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section: Deep Dives -->
      <section class="space-y-8">
        <h2 class="font-display text-2xl md:text-3xl text-[var(--fg)]">
          En profundidad: ambigüedades habituales
        </h2>

        <!-- Deep Dive 1: VISION.md -->
        <div class="border-l-2 border-[var(--rule)] pl-6 py-2">
          <h3 class="font-display text-xl text-[var(--fg)]">
            1. NORTH.md frente a VISION.md
          </h3>
          <p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">
            <strong>VISION.md</strong> no tiene una convención formal, pero donde existe suele describir el mundo que el proyecto aspira a crear. Está escrito para inspirar. Un agente que trabaja en una pull request un martes por la tarde no puede deducir de él si construir o comprar una cola de webhooks.
          </p>
          <p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">
            <strong>NORTH.md</strong> es operativo: declara apuestas asimétricas concretas (<em>"10x en la corrección de la facturación electrónica; 1.1x en la interfaz de ajustes"</em>), negativas específicas (<em>"Anti-objetivo: no construimos un CRM"</em>) y trade-offs por defecto precalculados (<em>"Seguridad sobre velocidad en código fiscal; velocidad sobre seguridad en la administración interna"</em>).
          </p>
        </div>

        <!-- Deep Dive 2: CONSTITUTION.md -->
        <div class="border-l-2 border-[var(--rule)] pl-6 py-2">
          <h3 class="font-display text-xl text-[var(--fg)]">
            2. NORTH.md frente a CONSTITUTION.md
          </h3>
          <p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">
            <strong>CONSTITUTION.md</strong> fija <em>principios y fronteras innegociables</em>. No hay un estándar único: <a href="https://agentconstitution.dev" class="underline decoration-dotted underline-offset-4 hover:text-[var(--fg)]">agentconstitution.dev</a> propone un formato a nivel de proyecto, y GitHub Spec Kit mantiene una constitución de proyecto con principios y gobernanza. Algunos formatos también recogen "pares en tensión" (X por encima de Y).
          </p>
          <p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">
            <strong>NORTH.md</strong> fija la <em>dirección</em>. Saber lo que nunca debes hacer no te dice qué calibre de trabajo se espera. NORTH.md le dice al agente dónde ser ambicioso y dónde parar. Si tu constitución ya recoge trade-offs, enlázala desde NORTH.md en lugar de repetirlos.
          </p>
        </div>

        <!-- Deep Dive 3: AGENTS.md -->
        <div class="border-l-2 border-[var(--rule)] pl-6 py-2">
          <h3 class="font-display text-xl text-[var(--fg)]">
            3. NORTH.md frente a AGENTS.md / CLAUDE.md
          </h3>
          <p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">
            <strong>AGENTS.md</strong> cubre la <em>mecánica de ejecución</em>: cómo compilar, qué linter ejecutar, qué convenciones seguir. Evita que el agente rompa el repositorio.
          </p>
          <p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">
            <strong>NORTH.md</strong> cubre el <em>criterio del incremento</em>: ¿está realmente terminada una funcionalidad cuando pasan los tests unitarios, o El Listón exige además documentación, una API pública y un registro de auditoría?
          </p>
        </div>

        <!-- Deep Dive 4: DESIGN.md -->
        <div class="border-l-2 border-[var(--rule)] pl-6 py-2">
          <h3 class="font-display text-xl text-[var(--fg)]">
            4. NORTH.md frente a DESIGN.md
          </h3>
          <p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">
            <strong>DESIGN.md</strong> es un formato de <a href="https://github.com/google-labs-code/design.md" class="underline decoration-dotted underline-offset-4 hover:text-[var(--fg)]">Google Labs</a> para describir una identidad visual a los agentes de código: tokens de diseño legibles por máquina en el front matter YAML, con la justificación en markdown. Está en fase alfa.
          </p>
          <p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">
            <strong>NORTH.md</strong> fija la <em>prioridad del oficio visual</em>: le indica al agente si las microanimaciones al píxel son una apuesta 10x (por ejemplo, en una landing) o una distracción sobrediseñada (en una tabla de administración interna).
          </p>
        </div>
      </section>

      <!-- Section: The Composition Model -->
      <section class="border-t border-[var(--rule)] pt-10">
        <h2 class="font-display text-2xl md:text-3xl text-[var(--fg)]">
          Un modelo de cinco capas que proponemos
        </h2>
        <p class="mt-4 text-[var(--muted)] leading-relaxed">
          En lugar de un único archivo largo de instrucciones, proponemos <strong class="text-[var(--fg)]">cinco archivos pequeños, cada uno con una pregunta</strong>. Es un modelo, no un estándar establecido, y la mayoría de los repositorios usará solo algunas de las capas.
        </p>

        <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
          {layers.map((l) => (
            <div class="rounded-lg border border-[var(--rule)] p-4 flex flex-col justify-between">
              <div>
                <p class="font-mono text-xs uppercase tracking-wider text-[var(--muted)]">{l.label}</p>
                <h3 class="mt-1 font-mono text-base font-semibold text-[var(--fg)]">{l.file}</h3>
                <p class="mt-2 text-xs text-[var(--muted)] leading-normal">{l.desc}</p>
              </div>
              <p class="mt-3 text-[0.65rem] font-mono text-[var(--muted)]">{l.origin}</p>
            </div>
          ))}

          <div class="rounded-lg border-2 border-[var(--accent)] bg-[color-mix(in_srgb,var(--accent)_5%,transparent)] p-4 flex flex-col justify-between">
            <div>
              <p class="font-mono text-xs uppercase tracking-wider text-[var(--accent)] font-semibold">Capa 5: Dirección</p>
              <h3 class="mt-1 font-mono text-base font-bold text-[var(--fg)] flex items-center gap-1.5">
                NORTH.md
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
              </h3>
              <p class="mt-2 text-xs text-[var(--fg)] font-medium leading-normal">
                Propósito, listón de calidad, apuestas asimétricas y trade-offs precalculados.
              </p>
            </div>
            <p class="mt-3 text-[0.65rem] font-mono text-[var(--accent)] font-semibold">Esta especificación · MIT</p>
          </div>
        </div>

        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="/es/spec"
            class="inline-flex items-center gap-2 rounded-full bg-[var(--fg)] px-5 py-2.5 text-sm font-medium text-[var(--bg)] transition hover:opacity-85"
          >
            Leer la especificación v0.1 &rarr;
          </a>
          <a
            href="/es"
            class="inline-flex items-center gap-2 rounded-full border border-[var(--rule)] px-5 py-2.5 text-sm font-medium text-[var(--fg)] transition hover:bg-[var(--rule)]"
          >
            Volver al inicio
          </a>
        </div>
      </section>
    </article>

    <!-- Footer -->
    <footer class="mt-20 border-t border-[var(--rule)] pt-10 text-sm text-[var(--muted)]">
      <p>
        <a href="/es" class="underline decoration-dotted underline-offset-4 hover:text-[var(--fg)]">&larr; Volver a northfile.dev</a>
      </p>
      <p class="mt-3">
        MIT &copy; <a href="https://brthls.com" class="underline decoration-dotted underline-offset-4 hover:text-[var(--fg)]">Viktor Berthelius</a> &middot;
        <a href="https://github.com/berthelius/north" class="underline decoration-dotted underline-offset-4 hover:text-[var(--fg)]">GitHub</a>
      </p>
    </footer>
  </main>
</Base>
