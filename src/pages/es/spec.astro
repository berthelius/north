const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: "Especificación NORTH.md (Español)",
  description:
    "La especificación canónica de NORTH.md en español: siete secciones para declarar el propósito, ambición y arbitraje de trade-offs de un proyecto.",
  version: "0.1",
  datePublished: "2026-09-24",
  dateModified: "2026-09-24",
  author: {
    "@type": "Person",
    name: "Viktor Berthelius",
    url: "https://brthls.com",
  },
  publisher: {
    "@type": "Organization",
    name: "BRTHLS",
    url: "https://brthls.com",
  },
  license: "https://opensource.org/licenses/MIT",
  url: "https://northfile.dev/es/spec",
  mainEntityOfPage: "https://northfile.dev/es/spec",
};
---

<Base
  title="Especificación — NORTH.md"
  description="La especificación canónica de NORTH.md. Siete secciones que dan criterio a tus agentes de IA cuando el prompt se termina."
  canonical="https://northfile.dev/es/spec"
  lang="es"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="spec-layout">
    <!-- Sticky TOC — desktop left column -->
    <aside class="toc-aside" aria-label="Tabla de contenidos">
      <nav class="toc-nav">
        <p class="toc-heading">Contenido</p>
        <ol class="toc-list">
          {
            sections.map((s) => (
              <li>
                <a href={`#${s.id}`} class="toc-link" data-section={s.id}>
                  {s.label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </aside>

    <!-- Mobile TOC — collapsible -->
    <details class="toc-mobile" aria-label="Tabla de contenidos">
      <summary class="toc-mobile-summary">
        <span>Contenido</span>
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M4 6l4 4 4-4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </summary>
      <nav aria-label="Tabla de contenidos (móvil)">
        <ol class="toc-mobile-list">
          {
            sections.map((s) => (
              <li>
                <a href={`#${s.id}`} class="toc-link">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </details>

    <!-- Main content -->
    <main class="spec-main" id="main-content">
      <!-- Header -->
      <header class="spec-header">
        <p class="spec-eyebrow">
          <span class="version-badge">v0.1</span>
        </p>
        <h1 class="spec-title">Especificación NORTH.md</h1>
        <div class="spec-meta">
          <span>Autor: <a href="https://brthls.com" class="spec-link">Viktor Berthelius</a> (BRTHLS)</span>
          <span class="meta-sep" aria-hidden="true">·</span>
          <span>Licencia: MIT</span>
          <span class="meta-sep" aria-hidden="true">·</span>
          <time datetime="2026-09-24">2026-09-24</time>
        </div>
        <div class="spec-actions">
          <a href="/es/spec.md" class="action-link" download>
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M8 2v9M4 8l4 4 4-4M3 14h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Descargar spec.md (ES)
          </a>
          <a href="https://github.com/berthelius/north" class="action-link">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M8 1C4.134 1 1 4.134 1 8c0 3.09 2.003 5.715 4.781 6.635.35.065.477-.151.477-.337 0-.166-.006-.604-.01-1.187-1.947.423-2.357-.94-2.357-.94-.318-.809-.777-1.025-.777-1.025-.635-.434.048-.425.048-.425.702.049 1.071.72 1.071.72.624 1.069 1.636.76 2.035.581.063-.451.244-.76.444-.935-1.554-.177-3.188-.777-3.188-3.459 0-.764.273-1.389.72-1.88-.072-.177-.312-.89.069-1.855 0 0 .587-.188 1.923.716A6.703 6.703 0 018 4.745c.595.003 1.193.08 1.752.236 1.334-.904 1.92-.716 1.92-.716.382.965.142 1.678.07 1.855.448.491.72 1.116.72 1.88 0 2.689-1.637 3.28-3.197 3.453.251.217.475.644.475 1.299 0 .937-.009 1.692-.009 1.922 0 .188.126.406.48.337C12.998 13.714 15 11.09 15 8c0-3.866-3.134-7-7-7z" fill="currentColor"/>
            </svg>
            GitHub
          </a>
        </div>
      </header>

      <div class="spec-body">

        <!-- Resumen -->
        <section aria-labelledby="resumen">
          <h2 id="resumen" class="section-heading">Resumen</h2>
          <p>
            <code>NORTH.md</code> es un único archivo markdown situado en la raíz de un proyecto de software
            que declara el <strong>propósito, ambición y trade-offs precalculados</strong> en un formato
            directamente interpretable por personas y agentes de programación con IA.
          </p>
          <p>Es la capa decisoria del <strong>stack de gobernanza de agentes en 5 capas</strong>:</p>
          <ul>
            <li><code>CONSTITUTION.md</code> — <strong>límites</strong> (seguridad, red lines, restricciones negativas).</li>
            <li><code>AGENTS.md</code> / <code>CLAUDE.md</code> — <strong>cómo</strong> operan los agentes (reglas, linters, tests).</li>
            <li><code>design.md</code> — <strong>diseño</strong> (tokens de interfaz, responsive, layout).</li>
            <li><code>SOUL.md</code> — <strong>quién</strong> es el producto (identidad, voz, valores).</li>
            <li><code>NORTH.md</code> — <strong>por qué</strong> y <strong>hasta dónde</strong> (propósito, calidad, arbitraje).</li>
          </ul>
        </section>

        <!-- Motivación -->
        <section aria-labelledby="motivacion">
          <h2 id="motivacion" class="section-heading">Motivación</h2>
          <p>
            Los agentes de programación actuales tienden por defecto a una <strong>producción segura e incremental</strong>.
            Optimizan para "no romper lo que funciona" antes que para "subir de nivel". Ante una tarea ambigua,
            eligen la interpretación más pequeña. Al proponer soluciones, sugieren parches en lugar de refactorizaciones estructurales.
            Cuando dudan, añaden manejo de errores defensivo en lugar de resolver la causa raíz en su origen.
          </p>
          <p>
            Los archivos a nivel de repositorio (<code>CLAUDE.md</code>, <code>AGENTS.md</code>) cubren aspectos <em>operativos</em>:
            qué comandos ejecutar, qué puertas de enlace respetar, qué convenciones seguir.
            Los archivos de identidad (<code>SOUL.md</code>) cubren aspectos <em>estéticos</em>: voz, tono, quiénes somos.
          </p>
          <p>Ninguna de esas capas responde a la pregunta decisiva:</p>
          <blockquote>
            ¿Hacia dónde va este proyecto y hasta dónde estamos dispuestos a empujar para llegar allí?
          </blockquote>
          <p><code>NORTH.md</code> responde a esa pregunta, en siete secciones canónicas, en un solo archivo.</p>
        </section>

        <!-- Ubicación -->
        <section aria-labelledby="ubicacion">
          <h2 id="ubicacion" class="section-heading">Ubicación del archivo</h2>
          <p><code>NORTH.md</code> DEBE ubicarse en la raíz del repositorio.</p>
          <p>
            Si un monorepo contiene múltiples productos diferenciados, cada producto PUEDE tener su propio
            <code>NORTH.md</code> en la raíz de su paquete. El <code>NORTH.md</code> de la raíz del monorepo describe
            entonces la ambición compartida general.
          </p>
        </section>

        <!-- Formato -->
        <section aria-labelledby="formato">
          <h2 id="formato" class="section-heading">Formato del archivo</h2>
          <p><code>NORTH.md</code> es un archivo CommonMark. DEBE contener las siete secciones canónicas definidas a continuación, en orden, cada una como encabezado H2.</p>
        </section>

        <!-- Las siete secciones -->
        <section aria-labelledby="siete-secciones">
          <h2 id="siete-secciones" class="section-heading">Las siete secciones</h2>

          <!-- 1. North Star -->
          <div class="spec-subsection" id="north-star">
            <h3 class="subsection-heading">1. North Star (Estrella Polar)</h3>
            <p>Una sola frase declarando el destino final. No el roadmap. No el próximo trimestre. El destino.</p>
            <ul>
              <li><strong>Suficientemente específica para descartar alternativas.</strong></li>
              <li><strong>Suficientemente ambiciosa para generar incomodidad.</strong></li>
              <li><strong>Alcanzable en principio.</strong> Justifica decisiones de ingeniería difíciles.</li>
            </ul>
            <div class="example-box">
              <p class="example-label">Ejemplo</p>
              <p class="example-text">Nordic ERP reemplaza el software tradicional para pymes europeas haciendo que la gestión empresarial nativa de IA sea el estándar por defecto para 2027.</p>
            </div>
          </div>

          <!-- 2. The Bar -->
          <div class="spec-subsection" id="the-bar">
            <h3 class="subsection-heading">2. The Bar (El Listón de Calidad)</h3>
            <p>El umbral de calidad que distingue lo "entregado" de lo "empezado". Define qué trabajo es aceptable considerar completado.</p>
            <ul>
              <li><strong>Medible u observable.</strong> Latencia, cobertura, accesibilidad AA, cero errores de tipado.</li>
              <li><strong>Superior al promedio de la industria.</strong></li>
              <li><strong>Defendido por barreras mecánicas.</strong> CI checks, linters, tests.</li>
            </ul>
            <div class="example-box">
              <p class="example-label">Ejemplo</p>
              <p class="example-text">Cada funcionalidad entregada pasa: typecheck, linter, suite completa de pruebas, Lighthouse ≥95 en todas las métricas, WCAG AA mediante axe, y paridad i18n. Cero excepciones, sin "TODO: pruebas luego".</p>
            </div>
          </div>

          <!-- 3. Asymmetric Bets -->
          <div class="spec-subsection" id="apuestas-asimetricas">
            <h3 class="subsection-heading">3. Apuestas Asimétricas</h3>
            <p>Los frentes donde deliberadamente invertimos un esfuerzo 10x, y los frentes donde 1.1x es deliberadamente correcto.</p>
            <ul>
              <li><strong>Dónde vamos a lo grande.</strong> Lo que merece inversión desproporcionada por ser decisivo.</li>
              <li><strong>Dónde entregamos estándar.</strong> Lo que está bien al 80% para concentrar capacidad en lo que diferencia.</li>
            </ul>
            <div class="example-box">
              <p class="example-label">Ejemplo</p>
              <p class="example-text">Apostar 10x en: modelo de interacción nativo de IA, cumplimiento fiscal, onboarding bajo 90 segundos.<br />Aceptar 1.1x en: pantallas de configuración admin, importación legacy, paneles internos.</p>
            </div>
          </div>

          <!-- 4. Anti-Goals -->
          <div class="spec-subsection" id="anti-objetivos">
            <h3 class="subsection-heading">4. Anti-Objetivos</h3>
            <p>Aquello que nos negamos explícitamente a hacer, incluso cuando sería fácil o rentable a corto plazo.</p>
            <ul>
              <li><strong>Tentador.</strong> Si nadie lo pediría, no es un anti-objetivo.</li>
              <li><strong>Justificado.</strong> Razón de una línea que resiste la presión.</li>
              <li><strong>Específico.</strong> Qué rechazamos exactamente.</li>
            </ul>
          </div>

          <!-- 5. Trade-offs -->
          <div class="spec-subsection" id="trade-offs">
            <h3 class="subsection-heading">5. Trade-offs por Defecto</h3>
            <p>Decisiones ya tomadas sobre dilemas recurrentes de ingeniería, documentadas una sola vez con condiciones explícitas de inversión (<em>Flip when</em>).</p>
            <div class="table-wrapper" role="region" aria-label="Tabla de trade-offs de ejemplo" tabindex="0">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Dilema</th>
                    <th scope="col">Opción por Defecto</th>
                    <th scope="col">Condición de Inversión (Flip when)</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Velocidad vs. seguridad</td>
                    <td>Seguridad en lógica financiera; velocidad en herramientas internas</td>
                    <td>Nunca invertir en código fiscal o criptográfico</td>
                  </tr>
                  <tr>
                    <td>Construir vs. comprar</td>
                    <td>Comprar infraestructura estándar (Postgres, Sentry)</td>
                    <td>El proveedor degrade la economía unitaria a >10k req/s</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- 6. Ambition Triggers -->
          <div class="spec-subsection" id="disparadores">
            <h3 class="subsection-heading">6. Disparadores de Ambición</h3>
            <p>Frases que escalan el alcance cuando el equipo o el modelo están pensando en pequeño.</p>
            <ul>
              <li><em>"¿Existe una versión 10x de esto?"</em></li>
              <li><em>"¿Qué entregaría un equipo de élite mundial en este caso?"</em></li>
              <li><em>"Si tuviéramos tres semanas en lugar de tres días, ¿qué cambiaría?"</em></li>
            </ul>
          </div>

          <!-- 7. Reversibility -->
          <div class="spec-subsection" id="reversibilidad">
            <h3 class="subsection-heading">7. Reversibilidad</h3>
            <p>Mapa entre puertas de un solo sentido (deliberar) y puertas de doble sentido (moverse rápido).</p>
            <ul>
              <li><strong>Un solo sentido:</strong> Cambios de esquema de base de datos en producción, APIs públicas, cálculos fiscales.</li>
              <li><strong>Doble sentido:</strong> Copy de UI, organización de carpetas internas, librerías auxiliares.</li>
              <li><strong>Disposición por defecto:</strong> Ante la duda, tratar como doble sentido y avanzar.</li>
            </ul>
          </div>
        </section>

        <!-- Propagación -->
        <section aria-labelledby="propagacion">
          <h2 id="propagacion" class="section-heading">Propagación</h2>
          <p>Referéncialo desde <code>CLAUDE.md</code> o <code>AGENTS.md</code> y muestra el badge en tu README:</p>
          <pre tabindex="0"><code>[![NORTH.md](https://northfile.dev/badge.svg)](https://northfile.dev/es)</code></pre>
        </section>

        <!-- Versionado -->
        <section aria-labelledby="versionado">
          <h2 id="versionado" class="section-heading">Versionado</h2>
          <p>Esta especificación sigue Versionado Semántico (semver). Puedes fijar la versión en la primera línea:</p>
          <pre tabindex="0"><code>&lt;!-- NORTH.md spec: v0.1 --&gt;</code></pre>
        </section>

        <!-- Relación -->
        <section aria-labelledby="relacion">
          <h2 id="relacion" class="section-heading">Relación con otras convenciones</h2>
          <div class="table-wrapper" role="region" aria-label="Ecosistema de gobernanza" tabindex="0">
            <table>
              <thead>
                <tr>
                  <th scope="col">Capa</th>
                  <th scope="col">Archivo</th>
                  <th scope="col">Pregunta Central</th>
                  <th scope="col">Custodio</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><code>Capa 1</code></td>
                  <td><code>CONSTITUTION.md</code></td>
                  <td>Límites y seguridad</td>
                  <td>Anthropic</td>
                </tr>
                <tr>
                  <td><code>Capa 2</code></td>
                  <td><code>AGENTS.md</code></td>
                  <td>Instrucciones de ejecución y tests</td>
                  <td>Linux Foundation</td>
                </tr>
                <tr>
                  <td><code>Capa 3</code></td>
                  <td><code>design.md</code></td>
                  <td>Tokens de UI y contratos visuales</td>
                  <td>Google Material</td>
                </tr>
                <tr>
                  <td><code>Capa 4</code></td>
                  <td><code>SOUL.md</code></td>
                  <td>Voz, tono y personalidad</td>
                  <td>Comunidad</td>
                </tr>
                <tr>
                  <td><code>Capa 5</code></td>
                  <td><code>NORTH.md</code></td>
                  <td>Propósito, calidad y trade-offs</td>
                  <td>BRTHLS</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- Changelog -->
        <section aria-labelledby="changelog">
          <h2 id="changelog" class="section-heading">Registro de cambios</h2>
          <h3 class="changelog-version-inline">
            v0.1
            <span class="changelog-date-inline">
              — <time datetime="2026-09-24">2026-09-24</time>
            </span>
          </h3>
          <ul>
            <li>Lanzamiento público canónico.</li>
            <li>Formalización de las siete secciones canónicas.</li>
            <li>Codificación del stack de gobernanza de agentes en 5 capas.</li>
            <li>Esquema estructurado de trade-offs con condición Flip when.</li>
          </ul>
        </section>

      </div>

      <!-- Footer -->
      <footer class="spec-footer">
        <p>
          MIT &copy; <a href="https://brthls.com" class="spec-link">Viktor Berthelius</a> &middot;
          <a href="https://github.com/berthelius/north" class="spec-link">GitHub</a>
        </p>
      </footer>
    </main>
  </div>
</Base>

<style>
  .spec-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 4rem) var(--spacing-gutter);
    gap: 3rem;
  }

  .toc-aside {
    display: block;
    position: sticky;
    top: 5rem;
