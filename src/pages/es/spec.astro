---
import Base from "../../layouts/Base.astro";

const sections = [
  { id: "resumen", label: "Resumen" },
  { id: "motivacion", label: "Motivación" },
  { id: "ubicacion", label: "Ubicación del archivo" },
  { id: "formato", label: "Formato del archivo" },
  { id: "siete-secciones", label: "Las siete secciones" },
  { id: "north-star", label: "1. North Star" },
  { id: "the-bar", label: "2. The Bar (El Listón)" },
  { id: "apuestas-asimetricas", label: "3. Apuestas Asimétricas" },
  { id: "anti-objetivos", label: "4. Anti-Objetivos" },
  { id: "trade-offs", label: "5. Trade-offs por Defecto" },
  { id: "disparadores", label: "6. Disparadores de Ambición" },
  { id: "reversibilidad", label: "7. Reversibilidad" },
  { id: "propagacion", label: "Propagación" },
  { id: "versionado", label: "Versionado" },
  { id: "relacion", label: "Relación con otras convenciones" },
