---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/landing/Hero.astro";
import LayersShowcase from "../../components/landing/LayersShowcase.astro";
import SevenSections from "../../components/landing/SevenSections.astro";
import TemplateBlock from "../../components/landing/TemplateBlock.astro";
import BadgeShowcase from "../../components/landing/BadgeShowcase.astro";
import LandingFooter from "../../components/landing/LandingFooter.astro";
import JsonLd from "../../components/seo/JsonLd.astro";
import {
  getWebSiteSchema,
  getDefinedTermSchema,
  getSoftwareSourceCodeSchema,
} from "../../components/seo/schemas";
---

<Base
  title="NORTH.md — Criterio para agentes de IA donde acaba el prompt"
  description="NORTH.md: un archivo markdown abierto que declara el propósito, la ambición y los trade-offs precalculados de un proyecto para personas y agentes de IA."
  lang="es"
>
  <JsonLd data={getWebSiteSchema("es")} />
  <JsonLd data={getDefinedTermSchema()} />
  <JsonLd data={getSoftwareSourceCodeSchema()} />

  <main id="main-content">
    <Hero lang="es" />
    <LayersShowcase lang="es" />
    <SevenSections lang="es" />
    <TemplateBlock lang="es" />
    <BadgeShowcase lang="es" />
  </main>
  <LandingFooter lang="es" />
</Base>
