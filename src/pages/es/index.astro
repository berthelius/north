---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/landing/Hero.astro";
import TrinityShowcase from "../../components/landing/TrinityShowcase.astro";
import SevenSections from "../../components/landing/SevenSections.astro";
import TemplateBlock from "../../components/landing/TemplateBlock.astro";
import BadgeShowcase from "../../components/landing/BadgeShowcase.astro";
import LandingFooter from "../../components/landing/LandingFooter.astro";
import JsonLd from "../../components/seo/JsonLd.astro";
import {
  getWebSiteSchema,
  getDefinedTermSchema,
  getSoftwareSourceCodeSchema,
} from "../../components/seo/schemas";
---

<Base
  title="NORTH.md — Dale a tus agentes de IA criterio cuando el prompt se termina"
  description="Un solo archivo markdown que declara el propósito, la ambición y los trade-offs precalculados de un proyecto, pensado para dar criterio a los agentes de IA cuando el prompt se termina."
  lang="es"
>
  <JsonLd data={getWebSiteSchema()} />
  <JsonLd data={getDefinedTermSchema()} />
  <JsonLd data={getSoftwareSourceCodeSchema()} />

  <main id="main-content">
    <Hero lang="es" />
    <TrinityShowcase lang="es" />
    <SevenSections lang="es" />
    <TemplateBlock lang="es" />
    <BadgeShowcase lang="es" />
  </main>
  <LandingFooter lang="es" />
</Base>
