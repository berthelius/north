---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page not found — NORTH.md"
  description="This page does not exist. Go back to the NORTH.md specification."
  noindex
>
  <main id="main-content" class="mx-auto max-w-3xl px-6 py-24 md:py-32">
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--muted)]">404</p>
    <h1 class="mt-5 font-display text-4xl md:text-5xl leading-[1.05] tracking-tight">
      Off course
    </h1>
    <p class="mt-6 max-w-prose text-[var(--muted)]">
      There is no page at this address. The destination has not moved:
      <a href="/" class="text-[var(--fg)] underline decoration-dotted underline-offset-4 hover:text-[var(--accent)]">home</a>
      or
      <a href="/spec" class="text-[var(--fg)] underline decoration-dotted underline-offset-4 hover:text-[var(--accent)]">the specification</a>.
    </p>
  </main>
</Base>
